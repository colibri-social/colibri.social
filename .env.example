# The DID to be served at /.well-known/atproto-did
SAME_TLD_DID=(optional)

# Error tracing (project: javascript-astro)
SENTRY_DSN=...
# Auth token for uploading source maps + creating releases at build time
SENTRY_AUTH_TOKEN=...
# Release identifier for this deploy (set to the git commit SHA). Ties uploaded
# source maps to runtime events and drives the Releases dashboard.
SENTRY_RELEASE=

# Web Push public VAPID key. Must match the AppView's VAPID_PUBLIC_KEY
PUBLIC_VAPID_KEY=
