{
	"name": "@colibri-social/website",
	"private": true,
	"type": "module",
	"version": "0.3.0",
	"engines": {
		"node": "^24.13.0"
	},
	"scripts": {
		"sync-assets": "pnpm --filter @colibri-social/assets fetch-all && node scripts/sync-shared-assets.mjs",
		"dev": "pnpm sync-assets && astro dev --host",
		"build": "pnpm sync-assets && astro build",
		"preview": "pnpm sync-assets && astro preview",
		"astro": "astro",
		"lint": "biome check .",
		"lint:fix": "biome check . --write",
		"test": "vitest run",
		"start": "node ./dist/server/entry.mjs",
		"publish-lexicons": "node --experimental-strip-types scripts/publish-lexicons.ts",
		"lexicons:export": "node --experimental-strip-types scripts/export-lexicons.ts"
	},
	"dependencies": {
		"@astrojs/node": "^11.1.6",
		"@astrojs/solid-js": "^7.0.2",
		"@astrojs/starlight": "^0.42.2",
		"@astrojs/starlight-tailwind": "^5.0.0",
		"@atproto/api": "0.0.0-spaces-alpha-20261112204144",
		"@atproto/lexicon": "0.0.0-spaces-alpha-20261112204144",
		"@colibri-social/app": "workspace:*",
		"@colibri-social/assets": "workspace:0.0.2",
		"@colibri-social/lexicons": "^2.38.0",
		"@colibri-social/lib": "workspace:*",
		"@colibri-social/standard-renderer": "workspace:0.0.2",
		"@fontsource-variable/hanken-grotesk": "^5.2.8",
		"@libsql/client": "^0.15.0",
		"@sentry/vite-plugin": "^5.3.0",
		"@shikijs/themes": "^4.0.2",
		"@tailwindcss/vite": "^4.3.2",
		"astro": "7.3.3",
		"clsx": "^2.1.1",
		"gsap": "^3.15.0",
		"ogl": "^1.0.11",
		"satori-astro": "^0.3.3",
		"satori-html": "^0.3.2",
		"sharp": "^0.34.5",
		"shiki": "^4.0.2",
		"solid-js": "^1.9.11",
		"starlight-theme-rapide": "^0.5.2",
		"tailwind-merge": "^3.4.0",
		"tailwindcss": "^4.1.18",
		"tw-animate-css": "^1.4.0",
		"typescript": "^5.9.3",
		"vidstack": "^1.12.13",
		"vite": "^8.1.3"
	},
	"devDependencies": {
		"@tailwindcss/typography": "^0.5.19",
		"@types/jsdom": "^28.0.0",
		"tsx": "^4.21.0",
		"vitest": "^4.1.10"
	}
}
