---
/**
 * Animated architecture diagram for the AppView page. Pure SVG + scoped CSS,
 * themed entirely off Starlight's `--sl-color-*` variables so it adapts to
 * light and dark automatically. Motion is disabled under
 * `prefers-reduced-motion`.
 */
---

<div class="appview-diagram not-content">
	<svg
		viewBox="0 0 820 440"
		role="img"
		aria-label="Data flow between the Colibri client, a PDS, Tap, the AppView and PostgreSQL."
		xmlns="http://www.w3.org/2000/svg"
	>
		<title>Colibri AppView architecture</title>
		<desc>
			The client sends requests through the user's PDS to the AppView and opens
			a direct WebSocket to it for live events. Tap consumes the ATproto
			firehose and relays events to the AppView. Both Tap and the AppView read
			from and write to a single PostgreSQL database.
		</desc>

		<defs>
			<marker
				id="arrow-accent"
				viewBox="0 0 10 10"
				refX="8"
				refY="5"
				markerWidth="6"
				markerHeight="6"
				orient="auto-start-reverse"
			>
				<path d="M0,0 L10,5 L0,10 z" class="arrowhead-accent"></path>
			</marker>
			<marker
				id="arrow-muted"
				viewBox="0 0 10 10"
				refX="8"
				refY="5"
				markerWidth="6"
				markerHeight="6"
				orient="auto-start-reverse"
			>
				<path d="M0,0 L10,5 L0,10 z" class="arrowhead-muted"></path>
			</marker>
		</defs>

		<!-- Edges: base line + animated flow overlay -->
		<!-- Client -> PDS -->
		<path class="edge" d="M190,157 L320,153"></path>
		<path
			class="flow flow-http"
			d="M190,157 L320,153"
			marker-end="url(#arrow-accent)"></path>
		<!-- PDS -> AppView -->
		<path class="edge" d="M470,153 L620,160"></path>
		<path
			class="flow flow-http"
			d="M470,153 L620,160"
			marker-end="url(#arrow-accent)"></path>
		<!-- Client <-> AppView (direct WebSocket): two lanes, one each way -->
		<path class="edge" d="M110,120 C205,34 555,34 686,120"></path>
		<path
			class="flow flow-ws"
			d="M110,120 C205,34 555,34 686,120"
			marker-end="url(#arrow-accent)"></path>
		<path class="edge" d="M694,120 C555,50 205,50 120,120"></path>
		<path
			class="flow flow-ws"
			d="M694,120 C555,50 205,50 120,120"
			marker-end="url(#arrow-accent)"></path>
		<!-- Firehose -> Tap -->
		<path class="edge" d="M190,328 L320,328"></path>
		<path
			class="flow flow-http"
			d="M190,328 L320,328"
			marker-end="url(#arrow-accent)"></path>
		<!-- Tap -> AppView (live events) -->
		<path class="edge" d="M470,328 C560,300 590,220 640,212"></path>
		<path
			class="flow flow-ws"
			d="M470,328 C560,300 590,220 640,212"
			marker-end="url(#arrow-accent)"></path>
		<!-- AppView <-> Postgres -->
		<path class="edge" d="M700,212 L680,360"></path>
		<path
			class="flow flow-sql"
			d="M700,212 L680,360"
			marker-end="url(#arrow-muted)"></path>
		<!-- Tap <-> Postgres -->
		<path class="edge" d="M395,356 C460,400 500,392 560,390"></path>
		<path
			class="flow flow-sql"
			d="M395,356 C460,400 500,392 560,390"
			marker-end="url(#arrow-muted)"></path>

		<!-- Edge labels -->
		<text class="e-label" x="255" y="144" text-anchor="middle">requests</text>
		<text class="e-label" x="548" y="147" text-anchor="middle"
			>service auth</text
		>
		<text class="e-label" x="402" y="42" text-anchor="middle"
			>subscribeEvents (direct WS connection)</text
		>
		<text class="e-label" x="255" y="318" text-anchor="middle">Firehose</text>
		<text class="e-label" x="612" y="258" text-anchor="middle"
			>live events (WS)</text
		>
		<text class="e-label" x="712" y="292" text-anchor="start">read / write</text
		>
		<text class="e-label" x="470" y="418" text-anchor="middle">writes</text>

		<!-- Nodes -->
		<g class="node-group">
			<rect class="node" x="40" y="120" width="150" height="74" rx="12"></rect>
			<text class="n-title" x="115" y="152" text-anchor="middle">Client</text>
			<text class="n-sub" x="115" y="171" text-anchor="middle">SolidJS UI</text>
		</g>
		<g class="node-group">
			<rect class="node" x="320" y="120" width="150" height="66" rx="12"></rect>
			<text class="n-title" x="395" y="149" text-anchor="middle">Your PDS</text>
			<text class="n-sub" x="395" y="168" text-anchor="middle"
				>ATproto proxy</text
			>
		</g>
		<g class="node-group">
			<rect class="node" x="40" y="300" width="150" height="56" rx="12"></rect>
			<text class="n-title" x="115" y="324" text-anchor="middle">Firehose</text>
			<text class="n-sub" x="115" y="343" text-anchor="middle"
				>ATproto network</text
			>
		</g>
		<g class="node-group">
			<rect class="node" x="320" y="300" width="150" height="56" rx="12"></rect>
			<text class="n-title" x="395" y="324" text-anchor="middle">Tap</text>
			<text class="n-sub" x="395" y="343" text-anchor="middle"
				>Backfill + Relay</text
			>
		</g>
		<g class="node-group">
			<rect class="node" x="560" y="360" width="180" height="60" rx="12"></rect>
			<text class="n-title" x="650" y="386" text-anchor="middle"
				>PostgreSQL</text
			>
			<text class="n-sub" x="650" y="405" text-anchor="middle"
				>shared store</text
			>
		</g>
		<g class="node-group">
			<rect
				class="node node-accent"
				x="620"
				y="120"
				width="160"
				height="92"
				rx="14"></rect>
			<text class="n-title" x="700" y="160" text-anchor="middle">AppView</text>
			<text class="n-sub n-sub-accent" x="700" y="180" text-anchor="middle"
				>Rocket</text
			>
		</g>
	</svg>
</div>

<style>
	.appview-diagram {
		width: 100%;
		max-width: 720px;
		margin: 2rem auto;
	}

	.appview-diagram svg {
		width: 100%;
		height: auto;
		display: block;
		overflow: visible;
	}

	.edge {
		fill: none;
		stroke: var(--sl-color-gray-5);
		stroke-width: 2;
	}

	.flow {
		fill: none;
		stroke-width: 2.5;
		stroke-linecap: round;
		stroke-dasharray: 2 10;
		animation: appview-flow 1.2s linear infinite;
	}

	.flow-http {
		stroke: var(--sl-color-text-accent);
	}

	.flow-ws {
		stroke: var(--sl-color-text-accent);
		opacity: 0.9;
		animation-duration: 0.9s;
	}

	.flow-sql {
		stroke: var(--sl-color-gray-3);
		animation-duration: 1.7s;
	}

	.arrowhead-accent {
		fill: var(--sl-color-text-accent);
	}

	.arrowhead-muted {
		fill: var(--sl-color-gray-3);
	}

	.node {
		fill: color-mix(in srgb, var(--sl-color-text-accent) 5%, transparent);
		stroke: var(--sl-color-gray-5);
		stroke-width: 1.5;
	}

	.node-accent {
		fill: color-mix(in srgb, var(--sl-color-text-accent) 13%, transparent);
		stroke: var(--sl-color-text-accent);
		stroke-width: 1.75;
		animation: appview-pulse 3s ease-in-out infinite;
	}

	.n-title {
		fill: var(--sl-color-text);
		font-family: var(--sl-font, sans-serif);
		font-weight: 700;
		font-size: 16px;
	}

	.n-sub {
		fill: var(--sl-color-gray-3);
		font-family: var(--font-geist-mono, monospace);
		font-size: 11px;
	}

	.n-sub-accent {
		fill: var(--sl-color-text-accent);
	}

	.e-label {
		fill: var(--sl-color-gray-3);
		font-family: var(--font-geist-mono, monospace);
		font-size: 11px;
	}

	@keyframes appview-flow {
		to {
			stroke-dashoffset: -12;
		}
	}

	@keyframes appview-pulse {
		0%,
		100% {
			stroke-opacity: 1;
		}
		50% {
			stroke-opacity: 0.45;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.flow,
		.node-accent {
			animation: none;
		}
	}
</style>
