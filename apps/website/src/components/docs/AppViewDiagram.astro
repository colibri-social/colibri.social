<div class="appview-diagram not-content">
	<svg
		viewBox="0 0 820 450"
		role="img"
		aria-label="Data flow between the Colibri client, a PDS, the AppView, member repositories and the AppView's local store."
		xmlns="http://www.w3.org/2000/svg"
	>
		<title>Colibri AppView architecture</title>
		<desc>
			The client sends requests through the user's PDS to the AppView and opens
			a direct WebSocket to it for live events. The community's PDS asks the
			AppView whether a user may read a space, and the AppView writes the
			community's records back to it. Holding a space credential, the AppView
			pulls each member's repository from that member's own host and stores what
			it reads locally.
		</desc>

		<defs>
			<marker
				id="arrow-accent"
				viewBox="0 0 10 10"
				refX="8"
				refY="5"
				markerWidth="6"
				markerHeight="6"
				orient="auto-start-reverse"
			>
				<path d="M0,0 L10,5 L0,10 z" class="arrowhead-accent"></path>
			</marker>
			<marker
				id="arrow-muted"
				viewBox="0 0 10 10"
				refX="8"
				refY="5"
				markerWidth="6"
				markerHeight="6"
				orient="auto-start-reverse"
			>
				<path d="M0,0 L10,5 L0,10 z" class="arrowhead-muted"></path>
			</marker>
		</defs>

		<path class="edge" d="M190,147 L310,147"></path>
		<path
			class="flow flow-http"
			d="M190,147 L310,147"
			marker-end="url(#arrow-accent)"></path>

		<path class="edge" d="M470,147 L620,148"></path>
		<path
			class="flow flow-http"
			d="M470,147 L620,148"
			marker-end="url(#arrow-accent)"></path>

		<path class="edge" d="M110,110 C205,24 555,24 686,104"></path>
		<path
			class="flow flow-ws"
			d="M110,110 C205,24 555,24 686,104"
			marker-end="url(#arrow-accent)"></path>
		<path class="edge" d="M694,104 C555,40 205,40 120,110"></path>
		<path
			class="flow flow-ws"
			d="M694,104 C555,40 205,40 120,110"
			marker-end="url(#arrow-accent)"></path>

		<path class="edge" d="M478,270 C572,254 612,222 646,198"></path>
		<path
			class="flow flow-http"
			d="M478,270 C572,254 612,222 646,198"
			marker-end="url(#arrow-accent)"></path>

		<path class="edge" d="M668,200 C632,252 566,302 480,300"></path>
		<path
			class="flow flow-http"
			d="M668,200 C632,252 566,302 480,300"
			marker-end="url(#arrow-accent)"></path>

		<path class="edge" d="M638,196 C558,344 380,398 216,386"></path>
		<path
			class="flow flow-http"
			d="M638,196 C558,344 380,398 216,386"
			marker-end="url(#arrow-accent)"></path>

		<path class="edge" d="M700,196 L700,350"></path>
		<path
			class="flow flow-sql"
			d="M700,196 L700,350"
			marker-end="url(#arrow-muted)"></path>

		<text class="e-label" x="250" y="138" text-anchor="middle">requests</text>
		<text class="e-label" x="545" y="138" text-anchor="middle"
			>service auth</text
		>
		<text class="e-label" x="400" y="32" text-anchor="middle"
			>subscribeEvents (direct WS connection)</text
		>
		<text class="e-label" x="556" y="228" text-anchor="middle"
			>checkUserAccess</text
		>
		<text class="e-label" x="566" y="320" text-anchor="middle"
			>community writes</text
		>
		<text class="e-label" x="404" y="410" text-anchor="middle"
			>listRepoOps / getRepo</text
		>
		<text class="e-label" x="712" y="278" text-anchor="start">read / write</text
		>

		<g class="node-group">
			<rect class="node" x="40" y="110" width="150" height="74" rx="12"></rect>
			<text class="n-title" x="115" y="142" text-anchor="middle">Client</text>
			<text class="n-sub" x="115" y="161" text-anchor="middle">SolidJS UI</text>
		</g>
		<g class="node-group">
			<rect class="node" x="310" y="110" width="160" height="74" rx="12"></rect>
			<text class="n-title" x="390" y="142" text-anchor="middle">Your PDS</text>
			<text class="n-sub" x="390" y="161" text-anchor="middle"
				>ATproto proxy</text
			>
		</g>
		<g class="node-group">
			<rect class="node" x="310" y="250" width="160" height="66" rx="12"></rect>
			<text class="n-title" x="390" y="276" text-anchor="middle"
				>Community PDS</text
			>
			<text class="n-sub" x="390" y="295" text-anchor="middle"
				>space authority</text
			>
		</g>
		<g class="node-group">
			<rect class="node" x="40" y="352" width="176" height="66" rx="12"></rect>
			<text class="n-title" x="128" y="378" text-anchor="middle"
				>Member repos</text
			>
			<text class="n-sub" x="128" y="397" text-anchor="middle"
				>on their own hosts</text
			>
		</g>
		<g class="node-group">
			<rect class="node" x="610" y="350" width="180" height="66" rx="12"></rect>
			<text class="n-title" x="700" y="376" text-anchor="middle"
				>Local store</text
			>
			<text class="n-sub" x="700" y="395" text-anchor="middle"
				>libSQL or Postgres</text
			>
		</g>
		<g class="node-group">
			<rect
				class="node node-accent"
				x="620"
				y="104"
				width="160"
				height="92"
				rx="14"></rect>
			<text class="n-title" x="700" y="144" text-anchor="middle">AppView</text>
			<text class="n-sub n-sub-accent" x="700" y="164" text-anchor="middle"
				>Node</text
			>
		</g>
	</svg>
</div>

<style>
	.appview-diagram {
		width: 100%;
		max-width: 720px;
		margin: 2rem auto;
	}

	.appview-diagram svg {
		width: 100%;
		height: auto;
		display: block;
		overflow: visible;
	}

	.edge {
		fill: none;
		stroke: var(--sl-color-gray-5);
		stroke-width: 2;
	}

	.flow {
		fill: none;
		stroke-width: 2.5;
		stroke-linecap: round;
		stroke-dasharray: 2 10;
		animation: appview-flow 1.2s linear infinite;
	}

	.flow-http {
		stroke: var(--sl-color-text-accent);
	}

	.flow-ws {
		stroke: var(--sl-color-text-accent);
		opacity: 0.9;
		animation-duration: 0.9s;
	}

	.flow-sql {
		stroke: var(--sl-color-gray-3);
		animation-duration: 1.7s;
	}

	.arrowhead-accent {
		fill: var(--sl-color-text-accent);
	}

	.arrowhead-muted {
		fill: var(--sl-color-gray-3);
	}

	.node {
		fill: color-mix(in srgb, var(--sl-color-text-accent) 5%, transparent);
		stroke: var(--sl-color-gray-5);
		stroke-width: 1.5;
	}

	.node-accent {
		fill: color-mix(in srgb, var(--sl-color-text-accent) 13%, transparent);
		stroke: var(--sl-color-text-accent);
		stroke-width: 1.75;
		animation: appview-pulse 3s ease-in-out infinite;
	}

	.n-title {
		fill: var(--sl-color-text);
		font-family: var(--sl-font, sans-serif);
		font-weight: 700;
		font-size: 16px;
	}

	.n-sub {
		fill: var(--sl-color-gray-3);
		font-family: var(--font-geist-mono, monospace);
		font-size: 11px;
	}

	.n-sub-accent {
		fill: var(--sl-color-text-accent);
	}

	.e-label {
		fill: var(--sl-color-gray-3);
		font-family: var(--font-geist-mono, monospace);
		font-size: 11px;
	}

	@keyframes appview-flow {
		to {
			stroke-dashoffset: -12;
		}
	}

	@keyframes appview-pulse {
		0%,
		100% {
			stroke-opacity: 1;
		}
		50% {
			stroke-opacity: 0.45;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.flow,
		.node-accent {
			animation: none;
		}
	}
</style>
