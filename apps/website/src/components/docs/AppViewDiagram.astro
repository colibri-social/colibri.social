<div class="appview-diagram not-content">
	<svg
		viewBox="0 0 820 500"
		role="img"
		aria-label="Data flow between the Colibri client, a PDS, the AppView, member repositories and the AppView's local store."
		xmlns="http://www.w3.org/2000/svg"
	>
		<title>Colibri AppView architecture</title>
		<desc>
			The client sends requests through the user's PDS to the AppView and opens
			a direct WebSocket to it for live events. The community's PDS asks the
			AppView whether a user may read a space, and the AppView writes the
			community's records back to it. Holding a space credential, the AppView
			pulls each member's repository from that member's own host and stores what
			it reads locally.
		</desc>

		<defs>
			<marker
				id="arrow-accent"
				viewBox="0 0 10 10"
				refX="8"
				refY="5"
				markerWidth="6"
				markerHeight="6"
				orient="auto-start-reverse"
			>
				<path d="M0,0 L10,5 L0,10 z" class="arrowhead-accent"></path>
			</marker>
			<marker
				id="arrow-muted"
				viewBox="0 0 10 10"
				refX="8"
				refY="5"
				markerWidth="6"
				markerHeight="6"
				orient="auto-start-reverse"
			>
				<path d="M0,0 L10,5 L0,10 z" class="arrowhead-muted"></path>
			</marker>
		</defs>

		<path class="edge" d="M105,160 L105,218"></path>
		<path
			class="flow flow-http"
			d="M105,160 L105,218"
			marker-end="url(#arrow-accent)"></path>

		<path class="edge" d="M180,254 L300,254"></path>
		<path
			class="flow flow-http"
			d="M180,254 L300,254"
			marker-end="url(#arrow-accent)"></path>

		<path
			class="edge"
			d="M105,88 L105,52 Q105,40 117,40 L418,40 Q430,40 430,52 L430,200"></path>
		<path
			class="flow flow-ws"
			d="M105,88 L105,52 Q105,40 117,40 L418,40 Q430,40 430,52 L430,200"
			marker-end="url(#arrow-accent)"></path>

		<path
			class="edge"
			d="M400,200 L400,72 Q400,60 388,60 L147,60 Q135,60 135,72 L135,88"></path>
		<path
			class="flow flow-ws"
			d="M400,200 L400,72 Q400,60 388,60 L147,60 Q135,60 135,72 L135,88"
			marker-end="url(#arrow-accent)"></path>

		<path class="edge" d="M500,240 L620,240"></path>
		<path
			class="flow flow-http"
			d="M500,240 L620,240"
			marker-end="url(#arrow-accent)"></path>

		<path class="edge" d="M620,268 L500,268"></path>
		<path
			class="flow flow-http"
			d="M620,268 L500,268"
			marker-end="url(#arrow-accent)"></path>

		<path class="edge" d="M340,308 L340,420 Q340,432 328,432 L180,432"></path>
		<path
			class="flow flow-http"
			d="M340,308 L340,420 Q340,432 328,432 L180,432"
			marker-end="url(#arrow-accent)"></path>

		<path class="edge" d="M460,308 L460,420 Q460,432 472,432 L620,432"></path>
		<path
			class="flow flow-sql"
			d="M460,308 L460,420 Q460,432 472,432 L620,432"
			marker-start="url(#arrow-muted)"
			marker-end="url(#arrow-muted)"></path>

		<text class="e-label" x="267" y="30" text-anchor="middle"
			>subscribeEvents (direct WS connection)</text
		>
		<text class="e-label" x="119" y="193" text-anchor="start">requests</text>
		<text class="e-label" x="240" y="244" text-anchor="middle">service auth</text
		>
		<text class="e-label" x="560" y="230" text-anchor="middle"
			>community writes</text
		>
		<text class="e-label" x="560" y="288" text-anchor="middle"
			>checkUserAccess</text
		>
		<text class="e-label" x="260" y="422" text-anchor="middle"
			>listRepoOps / getRepo</text
		>
		<text class="e-label" x="540" y="422" text-anchor="middle">read / write</text
		>

		<g class="node-group">
			<rect class="node" x="30" y="88" width="150" height="72" rx="12"></rect>
			<text class="n-title" x="105" y="120" text-anchor="middle">Client</text>
			<text class="n-sub" x="105" y="139" text-anchor="middle">SolidJS UI</text>
		</g>
		<g class="node-group">
			<rect class="node" x="30" y="218" width="150" height="72" rx="12"></rect>
			<text class="n-title" x="105" y="250" text-anchor="middle">Your PDS</text>
			<text class="n-sub" x="105" y="269" text-anchor="middle">ATproto proxy</text
			>
		</g>
		<g class="node-group">
			<rect class="node" x="620" y="218" width="170" height="72" rx="12"></rect>
			<text class="n-title" x="705" y="250" text-anchor="middle"
				>Community PDS</text
			>
			<text class="n-sub" x="705" y="269" text-anchor="middle"
				>space authority</text
			>
		</g>
		<g class="node-group">
			<rect class="node" x="30" y="396" width="150" height="72" rx="12"></rect>
			<text class="n-title" x="105" y="428" text-anchor="middle"
				>Member repos</text
			>
			<text class="n-sub" x="105" y="447" text-anchor="middle"
				>on their own hosts</text
			>
		</g>
		<g class="node-group">
			<rect class="node" x="620" y="396" width="170" height="72" rx="12"></rect>
			<text class="n-title" x="705" y="428" text-anchor="middle"
				>Local store</text
			>
			<text class="n-sub" x="705" y="447" text-anchor="middle"
				>libSQL or Postgres</text
			>
		</g>
		<g class="node-group">
			<rect
				class="node node-accent"
				x="300"
				y="200"
				width="200"
				height="108"
				rx="14"></rect>
			<text class="n-title" x="400" y="248" text-anchor="middle">AppView</text>
			<text class="n-sub n-sub-accent" x="400" y="270" text-anchor="middle"
				>Node</text
			>
		</g>
	</svg>
</div>

<style>
	.appview-diagram {
		width: 100%;
		max-width: 760px;
		margin: 2rem auto;
	}

	.appview-diagram svg {
		width: 100%;
		height: auto;
		display: block;
		overflow: visible;
	}

	.edge {
		fill: none;
		stroke: var(--sl-color-gray-5);
		stroke-width: 2;
	}

	.flow {
		fill: none;
		stroke-width: 2.5;
		stroke-linecap: round;
		stroke-dasharray: 2 10;
		animation: appview-flow 1.2s linear infinite;
	}

	.flow-http {
		stroke: var(--sl-color-text-accent);
	}

	.flow-ws {
		stroke: var(--sl-color-text-accent);
		opacity: 0.9;
		animation-duration: 0.9s;
	}

	.flow-sql {
		stroke: var(--sl-color-gray-3);
		animation-duration: 1.7s;
	}

	.arrowhead-accent {
		fill: var(--sl-color-text-accent);
	}

	.arrowhead-muted {
		fill: var(--sl-color-gray-3);
	}

	.node {
		fill: color-mix(in srgb, var(--sl-color-text-accent) 5%, transparent);
		stroke: var(--sl-color-gray-5);
		stroke-width: 1.5;
	}

	.node-accent {
		fill: color-mix(in srgb, var(--sl-color-text-accent) 13%, transparent);
		stroke: var(--sl-color-text-accent);
		stroke-width: 1.75;
		animation: appview-pulse 3s ease-in-out infinite;
	}

	.n-title {
		fill: var(--sl-color-text);
		font-family: var(--sl-font, sans-serif);
		font-weight: 700;
		font-size: 16px;
	}

	.n-sub {
		fill: var(--sl-color-gray-3);
		font-family: var(--font-geist-mono, monospace);
		font-size: 11px;
	}

	.n-sub-accent {
		fill: var(--sl-color-text-accent);
	}

	.e-label {
		fill: var(--sl-color-gray-3);
		font-family: var(--font-geist-mono, monospace);
		font-size: 11px;
	}

	@keyframes appview-flow {
		to {
			stroke-dashoffset: -12;
		}
	}

	@keyframes appview-pulse {
		0%,
		100% {
			stroke-opacity: 1;
		}
		50% {
			stroke-opacity: 0.45;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.flow,
		.node-accent {
			animation: none;
		}
	}
</style>
