---
/**
 * Where a community's records live. A member's own PDS repo holds the records
 * that user authors; the community's PDS repo (one DID = one community) holds
 * its structure and authoritative membership/moderation, written by the AppView
 * that holds its credentials. The AppView indexes both over the firehose. Pure
 * SVG + scoped CSS, themed off Starlight's `--sl-color-*` variables. Motion is
 * disabled under `prefers-reduced-motion`.
 */
---

<div class="records-diagram not-content">
	<svg
		viewBox="0 0 800 380"
		role="img"
		aria-label="A member's PDS repo and a community's PDS repo both stream over the firehose into the AppView, which also writes the community repo using its stored credentials."
		xmlns="http://www.w3.org/2000/svg"
	>
		<title>Where community records are stored</title>
		<desc>
			Each member's own PDS repo holds the records they author (messages,
			reactions, membership declarations, profile and status). A community is a
			single DID whose repo holds its structure (community, categories,
			channels, roles) plus authoritative member and moderation records, written
			by the AppView that holds the community's credentials. The AppView indexes
			every repo over the firehose.
		</desc>

		<defs>
			<marker
				id="rec-arrow-accent"
				viewBox="0 0 10 10"
				refX="8"
				refY="5"
				markerWidth="6"
				markerHeight="6"
				orient="auto-start-reverse"
			>
				<path d="M0,0 L10,5 L0,10 z" class="rec-arrowhead-accent"></path>
			</marker>
			<marker
				id="rec-arrow-muted"
				viewBox="0 0 10 10"
				refX="8"
				refY="5"
				markerWidth="6"
				markerHeight="6"
				orient="auto-start-reverse"
			>
				<path d="M0,0 L10,5 L0,10 z" class="rec-arrowhead-muted"></path>
			</marker>
		</defs>

		<!-- Member repo -> AppView (firehose) -->
		<path class="edge" d="M244,194 L288,194"></path>
		<path
			class="flow flow-fire"
			d="M244,194 L288,194"
			marker-end="url(#rec-arrow-accent)"></path>

		<!-- Community repo -> AppView (firehose, lower lane) -->
		<path class="edge" d="M545,212 L468,210"></path>
		<path
			class="flow flow-fire"
			d="M545,212 L468,210"
			marker-end="url(#rec-arrow-accent)"></path>

		<!-- AppView -> Community repo (credentialed writes, upper lane) -->
		<path class="edge" d="M468,178 L545,166"></path>
		<path
			class="flow flow-write"
			d="M468,178 L545,166"
			marker-end="url(#rec-arrow-muted)"></path>

		<!-- Edge labels -->
		<text class="e-label" x="266" y="186" text-anchor="middle">firehose</text>
		<text class="e-label" x="506" y="158" text-anchor="middle">writes</text>
		<text class="e-label" x="506" y="232" text-anchor="middle">firehose</text>

		<!-- Member repo -->
		<g class="node-group">
			<rect class="node" x="18" y="64" width="226" height="250" rx="14"></rect>
			<text class="r-title" x="34" y="96">Member's PDS repo</text>
			<text class="r-sub" x="34" y="115">self-owned by each user</text>
			<text class="r-ns" x="34" y="135">social.colibri.*</text>

			<circle class="dot" cx="36" cy="148" r="2"></circle>
			<text class="r-rec" x="46" y="152">message</text>
			<circle class="dot" cx="36" cy="172" r="2"></circle>
			<text class="r-rec" x="46" y="176">reaction</text>
			<circle class="dot" cx="36" cy="196" r="2"></circle>
			<text class="r-rec" x="46" y="200">membership</text>
			<circle class="dot" cx="36" cy="220" r="2"></circle>
			<text class="r-rec" x="46" y="224">actor.profile</text>
			<circle class="dot" cx="36" cy="244" r="2"></circle>
			<text class="r-rec" x="46" y="248">actor.data</text>
			<circle class="dot" cx="36" cy="268" r="2"></circle>
			<text class="r-rec" x="46" y="272">actor.mute</text>
		</g>

		<!-- AppView -->
		<g class="node-group">
			<rect
				class="node node-accent"
				x="288"
				y="152"
				width="180"
				height="84"
				rx="14"></rect>
			<text class="n-title" x="378" y="190" text-anchor="middle">AppView</text>
			<text class="n-sub" x="378" y="209" text-anchor="middle"
				>indexes every repo</text
			>
		</g>

		<!-- Community repo -->
		<g class="node-group">
			<rect
				class="node node-community"
				x="545"
				y="64"
				width="245"
				height="250"
				rx="14"></rect>
			<text class="r-title" x="561" y="96">Community's PDS repo</text>
			<text class="r-sub r-sub-community" x="561" y="115"
				>one DID = one community</text
			>
			<text class="r-ns" x="561" y="135">social.colibri.*</text>

			<circle class="dot dot-community" cx="563" cy="148" r="2"></circle>
			<text class="r-rec" x="573" y="152">community (self)</text>
			<circle class="dot dot-community" cx="563" cy="172" r="2"></circle>
			<text class="r-rec" x="573" y="176">category</text>
			<circle class="dot dot-community" cx="563" cy="196" r="2"></circle>
			<text class="r-rec" x="573" y="200">channel</text>
			<circle class="dot dot-community" cx="563" cy="220" r="2"></circle>
			<text class="r-rec" x="573" y="224">role</text>
			<circle class="dot dot-community" cx="563" cy="244" r="2"></circle>
			<text class="r-rec" x="573" y="248">member</text>
			<circle class="dot dot-community" cx="563" cy="268" r="2"></circle>
			<text class="r-rec" x="573" y="272">moderation</text>
		</g>
	</svg>
</div>

<style>
	.records-diagram {
		width: 100%;
		max-width: 720px;
		margin: 2rem auto;
	}

	.records-diagram svg {
		width: 100%;
		height: auto;
		display: block;
		overflow: visible;
	}

	.edge {
		fill: none;
		stroke: var(--sl-color-gray-5);
		stroke-width: 2;
	}

	.flow {
		fill: none;
		stroke-width: 2.5;
		stroke-linecap: round;
		stroke-dasharray: 2 10;
		animation: records-flow 1.1s linear infinite;
	}

	.flow-fire {
		stroke: var(--sl-color-text-accent);
	}

	.flow-write {
		stroke: var(--sl-color-gray-3);
		animation-duration: 1.5s;
	}

	.rec-arrowhead-accent {
		fill: var(--sl-color-text-accent);
	}

	.rec-arrowhead-muted {
		fill: var(--sl-color-gray-3);
	}

	.node {
		fill: color-mix(in srgb, var(--sl-color-text-accent) 5%, transparent);
		stroke: var(--sl-color-gray-5);
		stroke-width: 1.5;
	}

	.node-accent {
		fill: color-mix(in srgb, var(--sl-color-text-accent) 13%, transparent);
		stroke: var(--sl-color-text-accent);
		stroke-width: 1.75;
		animation: records-pulse 3s ease-in-out infinite;
	}

	.node-community {
		fill: color-mix(in srgb, var(--sl-color-text-accent) 8%, transparent);
		stroke: var(--sl-color-text-accent);
	}

	.n-title {
		fill: var(--sl-color-text);
		font-family: var(--sl-font, sans-serif);
		font-weight: 700;
		font-size: 16px;
	}

	.n-sub {
		fill: var(--sl-color-gray-3);
		font-family: var(--font-geist-mono, monospace);
		font-size: 11px;
	}

	.r-title {
		fill: var(--sl-color-text);
		font-family: var(--sl-font, sans-serif);
		font-weight: 700;
		font-size: 15px;
	}

	.r-sub {
		fill: var(--sl-color-gray-3);
		font-family: var(--font-geist-mono, monospace);
		font-size: 11px;
	}

	.r-sub-community {
		fill: var(--sl-color-text-accent);
	}

	.r-ns {
		fill: var(--sl-color-gray-3);
		font-family: var(--font-geist-mono, monospace);
		font-size: 10px;
		opacity: 0.7;
		letter-spacing: 0.04em;
	}

	.r-rec {
		fill: var(--sl-color-text);
		font-family: var(--font-geist-mono, monospace);
		font-size: 12px;
	}

	.dot {
		fill: var(--sl-color-text-accent);
	}

	.e-label {
		fill: var(--sl-color-gray-3);
		font-family: var(--font-geist-mono, monospace);
		font-size: 11px;
	}

	@keyframes records-flow {
		to {
			stroke-dashoffset: -12;
		}
	}

	@keyframes records-pulse {
		0%,
		100% {
			stroke-opacity: 1;
		}
		50% {
			stroke-opacity: 0.45;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.flow,
		.node-accent {
			animation: none;
		}
	}
</style>
