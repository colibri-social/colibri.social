<div class="records-diagram not-content">
	<svg
		viewBox="0 0 800 420"
		role="img"
		aria-label="A member's repo and the community's repo, both synced by the AppView, with a permissioned space drawn as a view across both."
		xmlns="http://www.w3.org/2000/svg"
	>
		<title>Where community records are stored</title>
		<desc>
			Each member's own repo holds the records they author, including messages,
			reactions and their personal preferences. The community is a single DID
			whose repo holds its structure and its authoritative member and moderation
			records, written by the AppView that holds its credentials. A permissioned
			space is not a container. It is an access-controlled view across every
			repo that writes into it, and the AppView reads each one directly using a
			space credential.
		</desc>

		<defs>
			<marker
				id="rec-arrow-accent"
				viewBox="0 0 10 10"
				refX="8"
				refY="5"
				markerWidth="6"
				markerHeight="6"
				orient="auto-start-reverse"
			>
				<path d="M0,0 L10,5 L0,10 z" class="rec-arrowhead-accent"></path>
			</marker>
			<marker
				id="rec-arrow-muted"
				viewBox="0 0 10 10"
				refX="8"
				refY="5"
				markerWidth="6"
				markerHeight="6"
				orient="auto-start-reverse"
			>
				<path d="M0,0 L10,5 L0,10 z" class="rec-arrowhead-muted"></path>
			</marker>
		</defs>

		<rect class="space-band" x="18" y="330" width="764" height="62" rx="14"
		></rect>
		<text class="s-title" x="34" y="356">A space is a view across both</text>
		<text class="s-sub" x="34" y="376"
			>at://authority/space/type/skey/author/collection/rkey</text
		>

		<path class="edge" d="M228,180 L314,180"></path>
		<path
			class="flow flow-fire"
			d="M228,180 L314,180"
			marker-end="url(#rec-arrow-accent)"></path>

		<path class="edge" d="M486,164 L572,152"></path>
		<path
			class="flow flow-write"
			d="M486,164 L572,152"
			marker-end="url(#rec-arrow-muted)"></path>

		<path class="edge" d="M572,202 L486,192"></path>
		<path
			class="flow flow-fire"
			d="M572,202 L486,192"
			marker-end="url(#rec-arrow-accent)"></path>

		<text class="e-label" x="271" y="172" text-anchor="middle">sync</text>
		<text class="e-label" x="529" y="138" text-anchor="middle">writes</text>
		<text class="e-label" x="529" y="220" text-anchor="middle">sync</text>

		<g class="node-group">
			<rect class="node" x="18" y="58" width="210" height="256" rx="14"></rect>
			<text class="r-title" x="34" y="90">Your repo</text>
			<text class="r-sub" x="34" y="109">on your own PDS</text>
			<text class="r-ns" x="34" y="129">social.colibri.*</text>

			<circle class="dot" cx="36" cy="148" r="2"></circle>
			<text class="r-rec" x="46" y="152">message</text>
			<circle class="dot" cx="36" cy="171" r="2"></circle>
			<text class="r-rec" x="46" y="175">reaction</text>
			<circle class="dot" cx="36" cy="194" r="2"></circle>
			<text class="r-rec" x="46" y="198">label</text>
			<circle class="dot" cx="36" cy="217" r="2"></circle>
			<text class="r-rec" x="46" y="221">actor.profile</text>
			<circle class="dot" cx="36" cy="240" r="2"></circle>
			<text class="r-rec" x="46" y="244">actor.mute</text>
			<circle class="dot" cx="36" cy="263" r="2"></circle>
			<text class="r-rec" x="46" y="267">actor.settings</text>
			<circle class="dot" cx="36" cy="286" r="2"></circle>
			<text class="r-rec" x="46" y="290">channel.read</text>
		</g>

		<g class="node-group">
			<rect
				class="node node-accent"
				x="314"
				y="150"
				width="172"
				height="84"
				rx="14"></rect>
			<text class="n-title" x="400" y="188" text-anchor="middle">AppView</text>
			<text class="n-sub" x="400" y="207" text-anchor="middle"
				>syncs every repo</text
			>
		</g>

		<g class="node-group">
			<rect
				class="node node-community"
				x="572"
				y="58"
				width="210"
				height="256"
				rx="14"></rect>
			<text class="r-title" x="588" y="90">The community's repo</text>
			<text class="r-sub r-sub-community" x="588" y="109"
				>one DID, one community</text
			>
			<text class="r-ns" x="588" y="129">social.colibri.*</text>

			<circle class="dot dot-community" cx="590" cy="148" r="2"></circle>
			<text class="r-rec" x="600" y="152">community (self)</text>
			<circle class="dot dot-community" cx="590" cy="171" r="2"></circle>
			<text class="r-rec" x="600" y="175">community.settings</text>
			<circle class="dot dot-community" cx="590" cy="194" r="2"></circle>
			<text class="r-rec" x="600" y="198">category</text>
			<circle class="dot dot-community" cx="590" cy="217" r="2"></circle>
			<text class="r-rec" x="600" y="221">channel (self)</text>
			<circle class="dot dot-community" cx="590" cy="240" r="2"></circle>
			<text class="r-rec" x="600" y="244">role</text>
			<circle class="dot dot-community" cx="590" cy="263" r="2"></circle>
			<text class="r-rec" x="600" y="267">member</text>
			<circle class="dot dot-community" cx="590" cy="286" r="2"></circle>
			<text class="r-rec" x="600" y="290">moderation</text>
		</g>
	</svg>
</div>

<style>
	.records-diagram {
		width: 100%;
		max-width: 720px;
		margin: 2rem auto;
	}

	.records-diagram svg {
		width: 100%;
		height: auto;
		display: block;
		overflow: visible;
	}

	.edge {
		fill: none;
		stroke: var(--sl-color-gray-5);
		stroke-width: 2;
	}

	.flow {
		fill: none;
		stroke-width: 2.5;
		stroke-linecap: round;
		stroke-dasharray: 2 10;
		animation: records-flow 1.1s linear infinite;
	}

	.flow-fire {
		stroke: var(--sl-color-text-accent);
	}

	.flow-write {
		stroke: var(--sl-color-gray-3);
		animation-duration: 1.5s;
	}

	.rec-arrowhead-accent {
		fill: var(--sl-color-text-accent);
	}

	.rec-arrowhead-muted {
		fill: var(--sl-color-gray-3);
	}

	.node {
		fill: color-mix(in srgb, var(--sl-color-text-accent) 5%, transparent);
		stroke: var(--sl-color-gray-5);
		stroke-width: 1.5;
	}

	.node-accent {
		fill: color-mix(in srgb, var(--sl-color-text-accent) 13%, transparent);
		stroke: var(--sl-color-text-accent);
		stroke-width: 1.75;
		animation: records-pulse 3s ease-in-out infinite;
	}

	.node-community {
		fill: color-mix(in srgb, var(--sl-color-text-accent) 8%, transparent);
		stroke: var(--sl-color-text-accent);
	}

	.space-band {
		fill: color-mix(in srgb, var(--sl-color-text-accent) 4%, transparent);
		stroke: var(--sl-color-text-accent);
		stroke-width: 1.5;
		stroke-dasharray: 6 6;
		opacity: 0.85;
	}

	.s-title {
		fill: var(--sl-color-text);
		font-family: var(--sl-font, sans-serif);
		font-weight: 700;
		font-size: 14px;
	}

	.s-sub {
		fill: var(--sl-color-gray-3);
		font-family: var(--font-geist-mono, monospace);
		font-size: 11px;
	}

	.n-title {
		fill: var(--sl-color-text);
		font-family: var(--sl-font, sans-serif);
		font-weight: 700;
		font-size: 16px;
	}

	.n-sub {
		fill: var(--sl-color-gray-3);
		font-family: var(--font-geist-mono, monospace);
		font-size: 11px;
	}

	.r-title {
		fill: var(--sl-color-text);
		font-family: var(--sl-font, sans-serif);
		font-weight: 700;
		font-size: 15px;
	}

	.r-sub {
		fill: var(--sl-color-gray-3);
		font-family: var(--font-geist-mono, monospace);
		font-size: 11px;
	}

	.r-sub-community {
		fill: var(--sl-color-text-accent);
	}

	.r-ns {
		fill: var(--sl-color-gray-3);
		font-family: var(--font-geist-mono, monospace);
		font-size: 10px;
		opacity: 0.7;
		letter-spacing: 0.04em;
	}

	.r-rec {
		fill: var(--sl-color-text);
		font-family: var(--font-geist-mono, monospace);
		font-size: 12px;
	}

	.dot {
		fill: var(--sl-color-text-accent);
	}

	.e-label {
		fill: var(--sl-color-gray-3);
		font-family: var(--font-geist-mono, monospace);
		font-size: 11px;
	}

	@keyframes records-flow {
		to {
			stroke-dashoffset: -12;
		}
	}

	@keyframes records-pulse {
		0%,
		100% {
			stroke-opacity: 1;
		}
		50% {
			stroke-opacity: 0.45;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.flow,
		.node-accent {
			animation: none;
		}
	}
</style>
