---
import { LEXICON_DOCS } from "@/utils/atproto/lexicons";
import LexiconDef from "./LexiconDef.astro";
import {
	defElementId,
	docCategory,
	type LexCategory,
	orderedDefs,
} from "./lexicon-utils.ts";

interface Props {
	category: LexCategory;
}

const { category } = Astro.props;
const docs = LEXICON_DOCS.filter((doc) => docCategory(doc) === category);
---

{
	docs.map((doc) => (
		<section class="lex-doc not-content">
			<h3 class="lex-doc-title" id={defElementId(doc.id, "main")}>
				{doc.id}
			</h3>
			<div class="lex-doc-meta">
				<span>lexicon v{doc.lexicon}</span>
				{doc.revision && <span>revision {doc.revision}</span>}
			</div>
			{orderedDefs(doc).map(([name, def]) => (
				<LexiconDef docId={doc.id} name={name} def={def} />
			))}
		</section>
	))
}
