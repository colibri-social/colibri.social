---
import { Image } from "astro:assets";
import Logo from "@/assets/logo.png";
---

<a
	href="/"
	class="w-42 flex flex-row gap-2 items-center focus:outline outline-primary rounded-sm"
>
	<Image
		src={Logo}
		width={32}
		height={32}
		alt={"A minimalist-looking hummingbird shape with a gradient from purple to white."}
		loading={"eager"}
	/>
	<span
		style={{ fontFamily: "var(--font-stardom)" }}
		class="text-xl not-italic leading-[normal]"
	>
		Colibri Social
	</span>
</a>
