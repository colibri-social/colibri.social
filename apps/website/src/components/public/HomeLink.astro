---
import Hummingbird from "@/assets/landing/hummingbird.svg";
---

<a href="/" class="home-link">
	<span class="home-link-mark">
		<Hummingbird width={26} height={37} aria-hidden="true" />
	</span>
	<span class="home-link-name">Colibri Social</span>
</a>

<style>
	.home-link {
		display: flex;
		align-items: center;
		gap: 8px;
		padding-block: 4px;
		color: #fff;
		text-decoration: none;
		border-radius: 8px;
	}

	.home-link:focus-visible {
		outline: 2px solid var(--site-primary);
		outline-offset: 3px;
	}

	.home-link-mark {
		width: 40px;
		height: 40px;
		display: grid;
		place-items: center;
	}

	.home-link-name {
		font-family: var(--font-sans);
		font-weight: 900;
		font-size: 18px;
		line-height: normal;
		white-space: nowrap;
	}
</style>
