---
import type { LinkData } from "./shared";

type Props = LinkData & { isFooterLink?: boolean };

const { href, text, isFooterLink, external } = Astro.props;
---

<a
	href={href}
	target={external ? "_blank" : undefined}
	rel={external ? "noreferrer" : undefined}
	class="hover:bg-white hover:text-black focus:bg-white focus:text-black px-2 flex items-center gap-0.5"
>
	<span
		class="relative"
		class:list={[!isFooterLink ? "-top-1 lg:-top-px" : "-top-px"]}>[</span
	>
	<span>{text}</span>
	<span
		class="relative"
		class:list={[!isFooterLink ? "-top-1 lg:-top-px" : "-top-px"]}>]</span
	>
</a>
