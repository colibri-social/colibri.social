const edgePath = ({ anchor, control }: Source) =>
	`M${anchor.x} ${anchor.y} Q${control.x} ${control.y} ${center.x} ${center.y}`;
const colibriColor = "#8e51ff";
const ringPoint = (angle: number) => ({
	x: center.x + Math.cos((angle * Math.PI) / 180) * ringRadius,
	y: center.y + Math.sin((angle * Math.PI) / 180) * ringRadius,
});
const geometry = JSON.stringify({
	center,
	ringRadius,
	colibriColor,
	sources,
});
---

<div
	class="bridge-graph"
	data-bridge-graph
	data-geometry={geometry}
	role="img"
	aria-label="Messages travel both ways along a graph between Colibri and other chat platforms"
>
	<svg viewBox="0 0 400 260" aria-hidden="true">
		<g>
			{
				sources.map((source) => (
					<path
						data-edge-rest
						d={edgePath(source)}
						fill="none"
						stroke="#fff"
						stroke-opacity="0.4"
						stroke-width="1.2"
						stroke-dasharray="2 4"
						stroke-linecap="round"
					/>
				))
			}
		</g>
		<g>
			{
				sources.map((source) => (
					<path
						data-edge-live
						d={edgePath(source)}
						fill="none"
						stroke="#fff"
						stroke-opacity="0.75"
						stroke-width="1.6"
						stroke-linecap="round"
						pathLength="1"
						stroke-dasharray="1 1"
						stroke-dashoffset="1"
					/>
				))
			}
		</g>
		<g>
			{
				sources.flatMap((source) =>
					source.nodes.map(([x, y]) => (
						<line
							data-spoke
							x1={source.anchor.x}
							y1={source.anchor.y}
							x2={x}
							y2={y}
							stroke="#fff"
							stroke-opacity="0.3"
							stroke-width="1"
						/>
					)),
				)
			}
			{
				sources.map(({ anchor, nodes: [first] }) => (
					<line
						data-outgoing-spoke
						x1={anchor.x}
						y1={anchor.y}
						x2={first?.[0]}
						y2={first?.[1]}
						stroke="#fff"
						stroke-opacity="0"
						stroke-width="1"
					/>
				))
			}
		</g>
		<circle
			data-halo
			cx={center.x}
			cy={center.y}
			r="38"
			fill="#fff"
			opacity="0"></circle>
		<circle
			data-ring
			cx={center.x}
			cy={center.y}
			r={ringRadius}
			fill="none"
			stroke="#fff"
			stroke-width="1"
			stroke-dasharray="1.5 4"
			opacity="0"></circle>
		<g>
			{
				sources.flatMap((source, index) =>
					[0, 1, 2].map((dot) => (
						<circle
							data-dot={index}
							r="2.6"
							fill={dot === 1 ? colibriColor : source.color}
							stroke="#fff"
							stroke-width="1"
							opacity="0"
						/>
					)),
				)
			}
		</g>
		<g>
			{
				sources.flatMap((source) =>
					source.nodes.map(([x, y]) => (
						<circle
							data-node
							cx={x}
							cy={y}
							r="5"
							fill={source.color}
							stroke="#fff"
							stroke-width="1.6"
						/>
					)),
				)
			}
			{
				sources.map(({ sector }) => {
					const { x, y } = ringPoint(sector);
					return (
						<circle
							data-outgoing
							cx={x}
							cy={y}
							r="4.4"
							fill={colibriColor}
							stroke="#fff"
							stroke-width="1.6"
						/>
					);
				})
			}
		</g>
		<g>
			{
				sources.map(({ id, anchor: { x, y } }) =>
					id === "minecraft" ? (
						<g>
							<rect
								x={x - 48}
								y={y - 17}
								width="96"
								height="34"
								rx="17"
								fill="#62b47a"
								stroke="#fff"
								stroke-width="2.5"
							/>
							<path
								d={logos.minecraft}
								fill="#0f0f0f"
								transform={`translate(${x - 38.4} ${y - 38.4}) scale(3.2)`}
							/>
						</g>
					) : id === "other" ? (
						<g>
							<circle
								cx={x}
								cy={y}
								r="22"
								fill="#8d8b96"
								stroke="#fff"
								stroke-width="2.5"
							/>
							<path
								d={logos.other}
								fill="#fff"
								transform={`translate(${x - 11} ${y - 11}) scale(${22 / 24})`}
							/>
							{[-4.6, 0, 4.6].map((offset) => (
								<circle cx={x + offset} cy={y - 1} r="1.5" fill="#8d8b96" />
							))}
						</g>
					) : (
						<g>
							<circle
								cx={x}
								cy={y}
								r="22"
								fill={id === "discord" ? "#5865f2" : "#fff"}
								stroke="#fff"
								stroke-width="2.5"
							/>
							<path
								d={logos[id]}
								fill={id === "discord" ? "#fff" : "#0f0f0f"}
								transform={
									id === "discord"
										? `translate(${x - 13} ${y - 13}) scale(${26 / 24})`
										: `translate(${x - 12} ${y - 12})`
								}
							/>
						</g>
					),
				)
			}
		</g>
		<g>
			<circle
				cx={center.x}
				cy={center.y}
				r="30"
				fill="#0f0f0f"
				stroke="#fff"
				stroke-width="2.5"></circle>
			<g
				transform={`translate(${center.x + 1} ${center.y}) scale(0.044) translate(-556 -515)`}
			>
				{bird.map((part) => <path d={part.d} fill={part.fill} />)}
			</g>
		</g>
	</svg>
</div>

<style>
	.bridge-graph {
		position: absolute;
		inset: 10px;
	}

	.bridge-graph svg {
		display: block;
		width: 100%;
		height: 100%;
		overflow: visible;
	}
</style>

<script>
	type Point = { x: number; y: number };
	type Source = {
		color: string;
		anchor: Point;
		control: Point;
		sector: number;
		nodes: Array<[number, number]>;
	};
	type Geometry = {
		center: Point;
		ringRadius: number;
		colibriColor: string;
		sources: Array<Source>;
	};
	type Edge = {
		source: Source;
		index: number;
		rest: SVGPathElement;
		live: SVGPathElement;
		dots: Array<SVGCircleElement>;
	};
	type Message = {
		source: Source;
		node: SVGCircleElement;
		spoke: SVGLineElement;
		start: Point;
		angle: number;
		delay: number;
	};
	type Outgoing = {
		source: Source;
		node: SVGCircleElement;
		spoke: SVGLineElement;
		start: Point;
		end: Point;
		delay: number;
	};

	const ringSpeed = 6;
	const forwardDuration = 1700;
	const backwardDuration = 1300;
	const ringSpacing = 22.5;
	const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

	const clamp01 = (value: number) => Math.min(1, Math.max(0, value));
	const easeInOut = (value: number) =>
		value < 0.5 ? 4 * value ** 3 : 1 - (-2 * value + 2) ** 3 / 2;
	const easeOut = (value: number) => 1 - (1 - value) ** 3;

	const quad = (from: Point, control: Point, to: Point, u: number) => {
		const rest = 1 - u;
		return {
			x: rest * rest * from.x + 2 * rest * u * control.x + u * u * to.x,
			y: rest * rest * from.y + 2 * rest * u * control.y + u * u * to.y,
		};
	};

	const toRgb = (hex: string) => {
		const value = Number.parseInt(hex.slice(1), 16);
		return [(value >> 16) & 255, (value >> 8) & 255, value & 255];
	};

	const mix = (from: string, to: string, amount: number) => {
		const a = toRgb(from);
		const b = toRgb(to);
		const [r, g, bl] = a.map((value, i) =>
			Math.round(value + ((b[i] ?? 0) - value) * amount),
		);
		return `rgb(${r}, ${g}, ${bl})`;
	};

	function initBridgeGraph(root: HTMLElement) {
		const geometry: Geometry = JSON.parse(root.dataset.geometry ?? "null");
		if (!geometry) return;
		const { center, ringRadius, colibriColor, sources } = geometry;

		const rests = root.querySelectorAll<SVGPathElement>("[data-edge-rest]");
		const lives = root.querySelectorAll<SVGPathElement>("[data-edge-live]");
		const nodes = root.querySelectorAll<SVGCircleElement>("[data-node]");
		const spokes = root.querySelectorAll<SVGLineElement>("[data-spoke]");
		const outgoingNodes =
			root.querySelectorAll<SVGCircleElement>("[data-outgoing]");
		const outgoingSpokes = root.querySelectorAll<SVGLineElement>(
			"[data-outgoing-spoke]",
		);
		const halo = root.querySelector<SVGCircleElement>("[data-halo]");
		const ring = root.querySelector<SVGCircleElement>("[data-ring]");
		if (!halo || !ring) return;

		const edges: Array<Edge> = sources.map((source, index) => ({
			source,
			index,
			rest: rests[index] as SVGPathElement,
			live: lives[index] as SVGPathElement,
			dots: [
				...root.querySelectorAll<SVGCircleElement>(`[data-dot="${index}"]`),
			],
		}));

		const total = sources.reduce((sum, source) => sum + source.nodes.length, 0);
		const messages: Array<Message> = sources.flatMap((source, index) =>
			source.nodes.map(([x, y], j) => {
				const order = sources
					.slice(0, index)
					.reduce((sum, previous) => sum + previous.nodes.length, j);
				return {
					source,
					node: nodes[order] as SVGCircleElement,
					spoke: spokes[order] as SVGLineElement,
					start: { x, y },
					angle:
						source.sector + (j - (source.nodes.length - 1) / 2) * ringSpacing,
					delay: 0.24 + ((j * sources.length + index) / total) * 0.4,
				};
			}),
		);

		const outgoing: Array<Outgoing> = sources.map((source, index) => {
			const radians = (source.sector * Math.PI) / 180;
			const [x, y] = source.nodes[0] ?? [source.anchor.x, source.anchor.y];
			return {
				source,
				node: outgoingNodes[index] as SVGCircleElement,
				spoke: outgoingSpokes[index] as SVGLineElement,
				start: {
					x: center.x + Math.cos(radians) * ringRadius,
					y: center.y + Math.sin(radians) * ringRadius,
				},
				end: { x, y },
				delay: 0.2 + index * 0.05,
			};
		});

		const bendFor = (source: Source, start: Point, end: Point) => ({
			x:
				(start.x + end.x) / 2 +
				(source.control.x - (source.anchor.x + center.x) / 2),
			y:
				(start.y + end.y) / 2 +
				(source.control.y - (source.anchor.y + center.y) / 2),
		});

		const render = (progress: number, time: number) => {
			const spin = time * ringSpeed;

			for (const edge of edges) {
				const drawn = easeInOut(clamp01((progress - edge.index * 0.06) / 0.3));
				edge.live.setAttribute("stroke-dashoffset", (1 - drawn).toFixed(4));
				edge.rest.setAttribute(
					"stroke-opacity",
					(0.4 * (1 - 0.85 * drawn)).toFixed(3),
				);
				const dotAlpha = easeOut(clamp01((drawn - 0.6) / 0.4));
				edge.dots.forEach((dot, i) => {
					const u = (time / 1.9 + i / 3 + edge.index * 0.21) % 1;
					const point = quad(
						edge.source.anchor,
						edge.source.control,
						center,
						i === 1 ? 1 - u : u,
					);
					dot.setAttribute("cx", point.x.toFixed(2));
					dot.setAttribute("cy", point.y.toFixed(2));
					dot.setAttribute(
						"opacity",
						(dotAlpha * Math.sin(Math.PI * u)).toFixed(3),
					);
				});
			}

			for (const message of messages) {
				const { source, start } = message;
				const moved = easeInOut(clamp01((progress - message.delay) / 0.36));
				const radians = ((message.angle + spin) * Math.PI) / 180;
				const end = {
					x: center.x + Math.cos(radians) * ringRadius,
					y: center.y + Math.sin(radians) * ringRadius,
				};
				const point = quad(start, bendFor(source, start, end), end, moved);
				message.node.setAttribute("cx", point.x.toFixed(2));
				message.node.setAttribute("cy", point.y.toFixed(2));
				message.node.setAttribute("r", (5 - 0.6 * moved).toFixed(2));
				message.node.setAttribute("fill", mix(source.color, "#ffffff", moved));
				message.node.setAttribute("stroke", mix("#ffffff", source.color, moved));
				message.spoke.setAttribute(
					"stroke-opacity",
					(0.3 * (1 - clamp01(moved * 3))).toFixed(3),
				);
			}

			for (const message of outgoing) {
				const { source, start, end } = message;
				const moved = easeInOut(clamp01((progress - message.delay) / 0.36));
				const point = quad(start, bendFor(source, start, end), end, moved);
				message.node.setAttribute("cx", point.x.toFixed(2));
				message.node.setAttribute("cy", point.y.toFixed(2));
				message.node.setAttribute("r", (4.4 + 0.6 * moved).toFixed(2));
				message.node.setAttribute("fill", mix(colibriColor, "#ffffff", moved));
				message.node.setAttribute("stroke", mix("#ffffff", colibriColor, moved));
				message.spoke.setAttribute(
					"stroke-opacity",
					(0.3 * clamp01((moved - 0.66) * 3)).toFixed(3),
				);
			}

			const ringIn = easeInOut(clamp01((progress - 0.5) / 0.5));
			ring.setAttribute("opacity", (0.35 * ringIn).toFixed(3));
			halo.setAttribute("r", (37 + 3 * Math.sin(time * 2.4)).toFixed(2));
			halo.setAttribute(
				"opacity",
				(0.14 * easeInOut(clamp01(progress / 0.6))).toFixed(3),
			);
		};

		const trigger = root.closest<HTMLElement>("article") ?? root;
		const state = {
			active: false,
			visible: false,
			progress: 0,
			time: 0,
			last: 0,
			frame: 0,
		};

		const tick = (now: number) => {
			const delta = state.last ? Math.min(64, now - state.last) : 16;
			state.last = now;
			const step =
				delta / (state.active ? forwardDuration : backwardDuration);
			state.progress = state.active
				? Math.min(1, state.progress + step)
				: Math.max(0, state.progress - step);
			state.time += delta / 1000;
			render(state.progress, state.time);
			if ((state.active || state.progress > 0) && state.visible) {
				state.frame = requestAnimationFrame(tick);
			} else {
				state.frame = 0;
				state.last = 0;
			}
		};

		const wake = () => {
			if (!state.frame && state.visible) {
				state.frame = requestAnimationFrame(tick);
			}
		};

		const setActive = (active: boolean) => {
			state.active = active && !reducedMotion.matches;
			wake();
		};

		trigger.addEventListener("pointerenter", () => setActive(true));
		trigger.addEventListener("pointerleave", () =>
			setActive(trigger.matches(":focus-within")),
		);
		trigger.addEventListener("focusin", () => setActive(true));
		trigger.addEventListener("focusout", (event) => {
			if (!trigger.contains(event.relatedTarget as Node | null)) {
				setActive(trigger.matches(":hover"));
			}
		});

		reducedMotion.addEventListener("change", () => {
			if (!reducedMotion.matches) return;
			state.active = false;
			state.progress = 0;
			render(0, state.time);
		});

		new IntersectionObserver(([entry]) => {
			state.visible = entry?.isIntersecting ?? false;
			if (state.visible) wake();
		}).observe(root);
	}

	for (const root of document.querySelectorAll<HTMLElement>(
		"[data-bridge-graph]",
	)) {
		initBridgeGraph(root);
	}
</script>
