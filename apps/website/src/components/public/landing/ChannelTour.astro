---

<div class="channel-tour" data-channel-tour aria-hidden="true">
	<div class="viewport" data-viewport>
		<div class="panel" data-panel>
			<div class="list">
				<div>
					<div class="wrap">
						<span class="pill"></span>
						<div class="row active" data-row="general">
							<span class="icon">
								<svg viewBox="0 0 24 24"
									><path
										fill-rule="evenodd"
										clip-rule="evenodd"
										d={chatIcon}
										fill="currentColor"></path></svg
								>
							</span>
							<span class="name">general</span>
						</div>
					</div>
					<div class="threads">
						<div class="wrap unread">
							<span class="pill"></span>
							<div class="row thread-row" data-row="thread">
								<span class="icon">
									<svg viewBox="0 0 192 192"
										><g
											transform="translate(96.44 96.27) rotate(45) translate(-50 -72)"
											fill="currentColor"
											><path
												d="M100 132.001C100 138.629 94.6274 144.001 88 144.001H12C5.37258 144.001 0 138.629 0 132.001C0 125.374 5.37258 120.001 12 120.001H88C94.6274 120.001 100 125.374 100 132.001Z"
