												x="6.57284"
												y="87.4715"
												width="90.5854"
												height="16.7031"
												rx="8.35153"
												transform="rotate(-30 6.57284 87.4715)"></rect><path
												d="M0 12C0 5.37258 5.37258 0 12 0H88C94.6274 0 100 5.37258 100 12C100 18.6274 94.6274 24 88 24H12C5.37258 24 0 18.6274 0 12Z"
											></path><path
												d="M8.86859 57.1305C7.00134 53.1262 8.73378 48.3663 12.7381 46.4991L84.8686 9.01733C88.8729 7.15009 93.6327 8.88253 95.5 12.8868C97.3672 16.8912 97.5043 20.8009 93.5 22.6682L19.5 61C15.4957 62.8672 10.7358 61.1348 8.86859 57.1305Z"
											></path></g
										></svg
									>
								</span>
								<span class="name">weekend game night</span>
							</div>
						</div>
					</div>
				</div>
				<div class="wrap unread">
					<span class="pill"></span>
					<div class="row" data-row="memes">
						<span class="icon">
							<svg viewBox="0 0 24 24"
								><path
									fill-rule="evenodd"
									clip-rule="evenodd"
									d={chatIcon}
									fill="currentColor"></path></svg
							>
						</span>
						<span class="name">memes</span>
					</div>
				</div>
				{
					voiceChannels.map(({ id, name }) => (
						<div class="voice" data-voice={id}>
							<div class="wrap">
								<div class="row voice-row" data-row={id}>
									<span class="icon quiet">
										<svg viewBox="0 0 24 24">
											<path d={volumeIcon} fill="currentColor" />
										</svg>
									</span>
									<span class="icon loud">
										<svg viewBox="0 0 24 24">
											{volumeLoudIcons.map((d) => (
												<path d={d} fill="currentColor" />
											))}
										</svg>
									</span>
									<span class="name">{name}</span>
								</div>
							</div>
							<div class="parts">
								<div class="parts-inner">
									<ul>
										<li class="part">
											<span class="avatar">Y</span>
											<span class="name">You</span>
										</li>
									</ul>
								</div>
							</div>
						</div>
					))
				}
			</div>
		</div>
	</div>
	<div class="cursor" data-cursor>
		<svg viewBox="0 0 24 24">
			<path
				d={cursorIcon}
				fill="#fff"
				stroke="#0b0b0c"
				stroke-width="1.1"
				stroke-linejoin="round"></path>
		</svg>
	</div>
</div>

<style>
	.channel-tour {
		--tour-hover: rgba(23, 23, 23, 0.6);
		--tour-avatar-fg: #2a1a00;
		--tour-ease: cubic-bezier(0.45, 0, 0.2, 1);
		--tour-move: 700ms;
		position: absolute;
		inset: 0;
		overflow: hidden;
		color: #fff;
		font-family: var(--font-sans);
		font-weight: 500;
	}

	.viewport {
		--fade-t: 0px;
		--fade-b: 0px;
		position: absolute;
		inset: 0;
		-webkit-mask-image: linear-gradient(
			to bottom,
			transparent 0,
			#000 var(--fade-t),
			#000 calc(100% - var(--fade-b)),
			transparent 100%
		);
		mask-image: linear-gradient(
			to bottom,
			transparent 0,
			#000 var(--fade-t),
			#000 calc(100% - var(--fade-b)),
			transparent 100%
		);
	}

	.viewport.fade-top {
		--fade-t: 18px;
	}

	.viewport.fade-bottom {
		--fade-b: 18px;
	}

	.panel {
		position: absolute;
		top: 0;
		left: 50%;
		box-sizing: border-box;
		width: 252px;
		padding: 8px;
		border-radius: 14px;
		background: var(--site-page);
		border: 1px solid var(--site-muted);
		box-shadow: 0 12px 32px rgba(0, 0, 0, 0.35);
		transform-origin: 50% 0;
		transform: translate(-50%, var(--pan, 10px)) scale(var(--s, 0.78));
		transition: transform var(--tour-move) var(--tour-ease);
		user-select: none;
	}

	.list {
		display: flex;
		flex-direction: column;
		gap: 8px;
	}

	.wrap {
		position: relative;
		display: flex;
	}

	.pill {
		position: absolute;
		left: -8px;
		top: 12px;
		width: 4px;
		height: 8px;
		border-radius: 0 999px 999px 0;
		background: #fff;
		opacity: 0;
		transform: scaleY(0.4);
		transition:
			opacity 0.2s,
			transform 0.2s;
	}

	.wrap.unread > .pill {
		opacity: 1;
		transform: none;
	}

	.row {
		position: relative;
		box-sizing: border-box;
		display: flex;
		align-items: center;
		gap: 8px;
		width: 100%;
		min-width: 0;
		height: 32px;
		padding: 6px 8px;
		border-radius: 8px;
		overflow: hidden;
		color: #a1a1a1;
		transition:
			background-color 0.15s,
			transform 0.12s;
	}

	.row.hover {
		background: var(--tour-hover);
	}

	.row.active {
		background: var(--site-popover);
	}

	.row.pressed {
		transform: scale(0.97);
	}

	.icon {
		display: flex;
		flex: none;
		width: 16px;
		height: 16px;
		color: #a1a1a1;
	}

	.icon svg {
		width: 16px;
		height: 16px;
	}

	.name {
		flex: 1;
		min-width: 0;
		overflow: hidden;
		white-space: nowrap;
		text-overflow: ellipsis;
		font-size: 16px;
		line-height: 20px;
		font-weight: 500;
		color: #a1a1a1;
	}

	.row.active .name,
	.wrap.unread .name {
		font-weight: 600;
		color: #fff;
	}

	.row.active .icon,
	.wrap.unread .icon {
		color: #fff;
	}

	.threads {
		display: flex;
		flex-direction: column;
		gap: 2px;
		margin-left: 16px;
		padding: 2px 0 0 8px;
		border-left: 1px solid var(--site-line);
	}

	.thread-row .name {
		font-size: 14px;
	}

	.voice-row {
		padding: 6px;
		border-left: 2px solid transparent;
		border-radius: 8px;
		transition:
			background-color 0.15s,
			transform 0.12s,
			border-color 0.2s;
	}

	.voice-row .name {
		font-weight: 600;
	}

	.voice.joined .voice-row {
		border-left-color: var(--site-primary);
		border-radius: 0 8px 8px 0;
		background-image: linear-gradient(
			90deg,
			color-mix(in srgb, var(--site-primary) 32%, transparent),
			color-mix(in srgb, var(--site-primary) 6%, transparent)
		);
	}

	.voice.joined .voice-row .name {
		color: #fff;
	}

	.voice.joined .voice-row .icon {
		color: var(--site-primary);
	}

	.voice .loud {
		display: none;
	}

	.voice.joined .loud {
		display: flex;
	}

	.voice.joined .quiet {
		display: none;
	}

	.voice {
		display: flex;
		flex-direction: column;
	}

	.parts {
		display: grid;
		grid-template-rows: 0fr;
		transition: grid-template-rows 0.26s var(--tour-ease);
	}

	.voice.joined .parts {
		grid-template-rows: 1fr;
	}

	.parts-inner {
		min-height: 0;
		overflow: hidden;
	}

	.parts ul {
		margin: 0;
		padding: 4px 0 0 24px;
		list-style: none;
		border-left: 2px solid var(--site-primary);
	}

	.part {
		display: flex;
		align-items: center;
		gap: 8px;
		padding: 4px;
	}

	.avatar {
		display: grid;
		place-items: center;
		flex: none;
		width: 24px;
		height: 24px;
		border-radius: 50%;
		background: var(--site-gold);
		color: var(--tour-avatar-fg);
		font-size: 12px;
		font-weight: 700;
		transform: scale(0.4);
		opacity: 0;
		transition:
			transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1) 0.08s,
			opacity 0.2s 0.08s;
	}

	.voice.joined .avatar {
		transform: none;
		opacity: 1;
	}

	.part .name {
		font-weight: 600;
	}

	.channel-tour :global(.rip) {
		position: absolute;
		border-radius: 50%;
		background: rgba(255, 255, 255, 0.14);
		pointer-events: none;
		transform: translate(-50%, -50%) scale(0);
		animation: channel-tour-rip 520ms ease-out forwards;
	}

	@keyframes channel-tour-rip {
		to {
			transform: translate(-50%, -50%) scale(1);
			opacity: 0;
		}
	}

	.cursor {
		position: absolute;
		top: 0;
		left: 0;
		z-index: 2;
		width: 22px;
		height: 22px;
		pointer-events: none;
		opacity: 0;
		transition:
			transform var(--tour-move) var(--tour-ease),
			opacity 0.2s;
	}

	.cursor.shown {
		opacity: 1;
	}

	.cursor.instant,
	.panel.instant {
		transition: none;
	}

	.cursor svg {
		display: block;
		width: 22px;
		height: 22px;
		margin: -4px 0 0 -4px;
		filter: drop-shadow(0 2px 4px rgba(0, 0, 0, 0.45));
		transform-origin: 4px 4px;
		transition: transform 0.12s;
	}

	.cursor.down svg {
		transform: scale(0.8);
	}

	@media (prefers-reduced-motion: reduce) {
		.panel,
		.parts,
		.avatar,
		.row,
		.pill,
		.voice-row {
			transition: none;
		}

		.cursor,
		.channel-tour :global(.rip) {
			display: none;
		}
	}
</style>

<script>
	type RowId = "general" | "thread" | "memes" | "gaming" | "chill";
	type VoiceId = Extract<RowId, "gaming" | "chill">;
	type Point = { x: number; y: number };

	const SCALE = 0.78;
	const MARGIN = 10;
	const MOVE = 700;
	const SETTLE = 220;
	const PRESS = 140;
	const PAUSE = 1100;
	const REDUCED_STEP = 2200;
	const TOUR: ReadonlyArray<RowId> = [
		"thread",
		"memes",
		"gaming",
		"general",
		"chill",
	];

	const isVoice = (id: RowId): id is VoiceId =>
		id === "gaming" || id === "chill";

	function initChannelTour(root: HTMLElement) {
		const card = root.closest<HTMLElement>(".card");
		const viewport = root.querySelector<HTMLElement>("[data-viewport]");
		const panel = root.querySelector<HTMLElement>("[data-panel]");
		const cursor = root.querySelector<HTMLElement>("[data-cursor]");
		if (!card || !viewport || !panel || !cursor) return;

		const reduce = window.matchMedia("(prefers-reduced-motion: reduce)");

		const state: {
			active: Exclude<RowId, VoiceId>;
			joined: VoiceId | null;
			unread: Partial<Record<RowId, boolean>>;
			step: number;
			focus: RowId;
		} = {
			active: "general",
			joined: null,
			unread: { thread: true, memes: true },
			step: 0,
			focus: "general",
		};

		let hovering = false;
		let timers: Array<ReturnType<typeof setTimeout>> = [];
		let scroll = 0;
		let cursorPlaced = false;

		const later = (fn: () => void, ms: number) => {
			timers.push(setTimeout(fn, ms));
		};

		const clearTimers = () => {
			for (const timer of timers) clearTimeout(timer);
			timers = [];
		};

		const rowEl = (id: RowId) =>
			panel.querySelector<HTMLElement>(`[data-row="${id}"]`);

		const offsetIn = (el: HTMLElement): Point => {
			let x = 0;
			let y = 0;
			let node: Element | null = el;
			while (node instanceof HTMLElement && node !== panel) {
				x += node.offsetLeft;
				y += node.offsetTop;
				node = node.offsetParent;
			}
			return { x, y };
		};

		const viewportHeight = () => root.clientHeight;
		const contentHeight = () => panel.offsetHeight * SCALE + MARGIN * 2;

		const panFor = (row: HTMLElement) => {
			const offset = offsetIn(row);
			const center = MARGIN + (offset.y + row.offsetHeight / 2) * SCALE;
			const max = Math.max(0, contentHeight() - viewportHeight());
			return Math.min(max, Math.max(0, center - viewportHeight() / 2));
		};

		const setPan = (value: number) => {
			scroll = value;
			panel.style.setProperty("--pan", `${MARGIN - value}px`);
			panel.style.setProperty("--s", String(SCALE));
			viewport.classList.toggle("fade-top", value > 1);
			viewport.classList.toggle(
				"fade-bottom",
				contentHeight() - viewportHeight() - value > 1,
			);
		};

		const localPoint = (row: HTMLElement): Point => ({
			x: Math.min(row.offsetWidth * 0.55, 110),
			y: row.offsetHeight * 0.62,
		});

		const pointOn = (row: HTMLElement): Point => {
			const offset = offsetIn(row);
			const local = localPoint(row);
			return {
				x:
					root.clientWidth / 2 +
					(offset.x + local.x - panel.offsetWidth / 2) * SCALE,
				y: MARGIN - scroll + (offset.y + local.y) * SCALE,
			};
		};

		const placeCursor = (point: Point) => {
			cursor.style.transform = `translate(${point.x}px, ${point.y}px)`;
		};

		const instantly = (fn: () => void) => {
			cursor.classList.add("instant");
			panel.classList.add("instant");
			fn();
			void panel.offsetWidth;
			cursor.classList.remove("instant");
			panel.classList.remove("instant");
		};

		const render = () => {
			for (const row of panel.querySelectorAll<HTMLElement>("[data-row]")) {
				const id = row.dataset.row as RowId;
				if (isVoice(id)) continue;
				row.classList.toggle("active", id === state.active);
				row.parentElement?.classList.toggle(
					"unread",
					Boolean(state.unread[id]) && id !== state.active,
				);
			}
			for (const voice of panel.querySelectorAll<HTMLElement>("[data-voice]")) {
				voice.classList.toggle("joined", voice.dataset.voice === state.joined);
			}
		};

		const apply = (id: RowId) => {
			if (isVoice(id)) {
				state.joined = id;
			} else {
				state.active = id;
				state.unread[id] = false;
			}
			state.focus = id;
			state.step = (state.step + 1) % TOUR.length;
			if (state.step === 0 && state.active !== "memes") {
				state.unread.memes = true;
			}
			render();
		};

		const ripple = (row: HTMLElement) => {
			const local = localPoint(row);
			const size = row.offsetWidth * 2.2;
			const dot = document.createElement("span");
			dot.className = "rip";
			dot.style.left = `${local.x}px`;
			dot.style.top = `${local.y}px`;
			dot.style.width = `${size}px`;
			dot.style.height = `${size}px`;
			row.appendChild(dot);
			dot.addEventListener("animationend", () => dot.remove());
		};

		const clearRowStates = () => {
			for (const row of panel.querySelectorAll<HTMLElement>("[data-row]")) {
				row.classList.remove("hover", "pressed");
			}
			cursor.classList.remove("down");
		};

		const tourStep = () => {
			if (!hovering) return;
			const id = TOUR[state.step];
			const row = rowEl(id);
			if (!row) return;
			setPan(panFor(row));
			placeCursor(pointOn(row));
			later(() => {
				row.classList.add("hover");
				later(() => {
					cursor.classList.add("down");
					row.classList.add("pressed");
					ripple(row);
					apply(id);
					later(() => {
						cursor.classList.remove("down");
						row.classList.remove("pressed");
						later(() => {
							setPan(panFor(row));
							placeCursor(pointOn(row));
						}, 300);
						later(() => {
							row.classList.remove("hover");
							tourStep();
						}, PAUSE);
					}, PRESS);
				}, SETTLE);
			}, MOVE);
		};

		const reducedStep = () => {
			if (!hovering) return;
			const id = TOUR[state.step];
			apply(id);
			const row = rowEl(id);
			if (row) setPan(panFor(row));
			later(reducedStep, REDUCED_STEP);
		};

		const enter = () => {
			if (hovering) return;
			hovering = true;
			clearTimers();
			if (reduce.matches) {
				later(reducedStep, 600);
				return;
			}
			if (!cursorPlaced) {
				cursorPlaced = true;
				instantly(() =>
					placeCursor({
						x: root.clientWidth * 0.84,
						y: viewportHeight() * 0.86,
					}),
				);
			}
			cursor.classList.add("shown");
			later(tourStep, 250);
		};

		const leave = () => {
			hovering = false;
			clearTimers();
			cursor.classList.remove("shown");
			clearRowStates();
		};

		const relayout = () => {
			const row = rowEl(state.focus);
			if (!row) return;
			instantly(() => {
				setPan(panFor(row));
				if (cursorPlaced) placeCursor(pointOn(row));
			});
		};

		card.addEventListener("pointerenter", enter);
		card.addEventListener("pointerleave", leave);

		render();
		relayout();
		new ResizeObserver(relayout).observe(root);
		document.fonts.ready.then(relayout);
	}

	for (const root of document.querySelectorAll<HTMLElement>(
		"[data-channel-tour]",
	)) {
		initChannelTour(root);
	}
</script>
