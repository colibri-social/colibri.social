			d: "M4.17157 3.17157C3 4.34315 3 6.22876 3 10V14C3 17.7712 3 19.6569 4.17157 20.8284C5.34315 22 7.22876 22 11 22H13C16.7712 22 18.6569 22 19.8284 20.8284C21 19.6569 21 17.7712 21 14V10C21 6.22876 21 4.34315 19.8284 3.17157C18.6569 2 16.7712 2 13 2H11C7.22876 2 5.34315 2 4.17157 3.17157ZM7.25 8C7.25 7.58579 7.58579 7.25 8 7.25H16C16.4142 7.25 16.75 7.58579 16.75 8C16.75 8.41421 16.4142 8.75 16 8.75H8C7.58579 8.75 7.25 8.41421 7.25 8ZM7.25 12C7.25 11.5858 7.58579 11.25 8 11.25H16C16.4142 11.25 16.75 11.5858 16.75 12C16.75 12.4142 16.4142 12.75 16 12.75H8C7.58579 12.75 7.25 12.4142 7.25 12ZM8 15.25C7.58579 15.25 7.25 15.5858 7.25 16C7.25 16.4142 7.58579 16.75 8 16.75H13C13.4142 16.75 13.75 16.4142 13.75 16C13.75 15.5858 13.4142 15.25 13 15.25H8Z",
			evenOdd: true,
		},
	],
	zip: [
		{
			d: "M4.17157 3.17157C3 4.34315 3 6.22876 3 10V14C3 17.7712 3 19.6569 4.17157 20.8284C5.34315 22 7.22876 22 11 22H13C16.7712 22 18.6569 22 19.8284 20.8284C21 19.6569 21 17.7712 21 14V10C21 6.22876 21 4.34315 19.8284 3.17157C18.6569 2 16.7712 2 13 2H12V3V4H13.5C13.9714 4 14.2071 4 14.3536 4.14645C14.5 4.29289 14.5 4.5286 14.5 5C14.5 5.4714 14.5 5.70711 14.3536 5.85355C14.2071 6 13.9714 6 13.5 6H12V8H13.5C13.9714 8 14.2071 8 14.3536 8.14645C14.5 8.29289 14.5 8.5286 14.5 9C14.5 9.4714 14.5 9.70711 14.3536 9.85355C14.2071 10 13.9714 10 13.5 10H13C12.5286 10 12.2929 10 12.1464 9.85355C12 9.70711 12 9.4714 12 9V8H10.5C10.0286 8 9.79289 8 9.64645 7.85355C9.5 7.70711 9.5 7.4714 9.5 7C9.5 6.5286 9.5 6.29289 9.64645 6.14645C9.79289 6 10.0286 6 10.5 6H12V4H10.5C10.0286 4 9.79289 4 9.64645 3.85355C9.5 3.70711 9.5 3.4714 9.5 3V2.00338C6.70613 2.02377 5.17628 2.16686 4.17157 3.17157ZM9.5 12.875V13C9.5 14.3807 10.6193 15.5 12 15.5C13.3807 15.5 14.5 14.3807 14.5 13V12.875C14.5 12.3918 14.1082 12 13.625 12H10.375C9.89175 12 9.5 12.3918 9.5 12.875Z",
			evenOdd: true,
