---
interface Props {
	count?: number;
	class?: string;
}

const { count = 40, class: className = "" } = Astro.props;

function mulberry32(seed: number) {
	let a = seed;
	return () => {
		a |= 0;
		a = (a + 0x6d2b79f5) | 0;
		let t = Math.imul(a ^ (a >>> 15), 1 | a);
		t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
		return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
	};
}

const rand = mulberry32(0xc0_1b_21);
const range = (r: () => number, min: number, max: number) =>
	min + r() * (max - min);

const petals = Array.from({ length: count }, () => ({
	size: range(rand, 9, 20),
	swayDur: range(rand, 3, 6),
	opacity: range(rand, 0.18, 0.5),
	blur: range(rand, 0, 1),
}));
---

<div class={`petal-field ${className}`} aria-hidden="true">
	<svg width="0" height="0" class="absolute" aria-hidden="true">
		<defs>
			<radialGradient id="petal-grad" cx="42%" cy="30%" r="80%">
				<stop offset="0%" stop-color="#ffffff"></stop>
				<stop offset="55%" stop-color="#d9d9d9"></stop>
				<stop offset="100%" stop-color="#9c9c9c"></stop>
			</radialGradient>
			<symbol id="petal-shape" viewBox="0 0 60 90">
				<path
					d="M30 86 C14 74 4 54 8 36 C10 22 12 12 20 9 C25 7 29 12 30 22 C31 12 35 7 40 9 C48 12 50 22 52 36 C56 54 46 74 30 86 Z"
					fill="url(#petal-grad)"></path>
			</symbol>
		</defs>
	</svg>
	{
		petals.map((p) => (
			<span class="petal" style={`opacity:${p.opacity};`}>
				<svg
					class="petal-inner"
					width={p.size}
					height={p.size * 1.5}
					viewBox="0 0 60 90"
					style={`--sway-dur:${p.swayDur}s; filter:blur(${p.blur}px);`}
				>
					<use href="#petal-shape" />
				</svg>
			</span>
		))
	}
</div>

<style>
	.petal-field {
		position: absolute;
		inset: 0;
		z-index: -1;
		pointer-events: none;
		overflow: hidden;
	}

	.petal {
		position: absolute;
		top: 0;
		left: 0;
		will-change: transform;
	}

	.petal-inner {
		display: block;
		will-change: transform;
		transform-origin: center;
		animation: petal-sway var(--sway-dur) ease-in-out infinite alternate;
	}

	@keyframes petal-sway {
		0% {
			transform: rotate(-16deg);
		}
		100% {
			transform: rotate(16deg);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.petal-field {
			display: none;
		}
	}
</style>
