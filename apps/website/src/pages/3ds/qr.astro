---
import PublicLayout from "@/layouts/PublicLayout.astro";
---

<PublicLayout
  title="QR Code"
  description="Why'd you even bother sharing the link?"
>
  <section class="py-40 mx-auto w-full max-w-336 md:px-16 px-6 relative flex flex-col items-center gap-12 h-screen justify-center">
    <div class="flex flex-col gap-4 items-center text-center">
      <h1 class="reset h-fit leading-56 text-[192px] font-black m-0">
        (Insert QR Code)
      </h1>
      <p class="m-0 text-muted-foreground">
        Scan the QR code above with your 3DS to continue.
      </p>
    </div>
  </section>
</PublicLayout>
