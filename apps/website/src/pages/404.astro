---
import NavLink from "@/components/public/NavLink.astro";
import PageBand from "@/components/public/PageBand.astro";
import PublicLayout from "@/layouts/PublicLayout.astro";
---

<PublicLayout
	title="Page Not Found"
	description="We were unable to find the page you're looking for."
	starry
>
	<PageBand labelledby="lost-title" class="lost">
		<h1 class="lost-code reset" id="lost-title">404</h1>
		<p class="page-band-lead lost-lead">
			This page flew off somewhere. Try one of these instead:
		</p>
		<nav class="lost-links" aria-label="Helpful links">
			<NavLink text="Home" href="/" />
			<NavLink text="Web-App" href="/app" />
			<NavLink text="FAQ" href="/faq" />
		</nav>
	</PageBand>
</PublicLayout>

<style>
	.lost {
		min-height: 860px;
		padding-top: clamp(150px, 14vw, 200px);
		padding-bottom: 160px;
	}

	.lost .lost-code {
		font-family: var(--font-stardom);
		font-weight: 400;
		font-size: clamp(150px, 20vw, 280px);
		line-height: 0.8;
		text-shadow:
			0 0 24px rgba(0, 0, 0, 0.45),
			0 4px 40px rgba(16, 13, 26, 0.6);
	}

	.lost-lead {
		max-width: 44ch;
	}

	.lost-links {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 8px 12px;
		margin-top: 8px;
		font-size: 19px;
	}

</style>
