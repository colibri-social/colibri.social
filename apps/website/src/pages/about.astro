---
import { getEntry, render } from "astro:content";
import ProsePage from "@/components/public/prose/ProsePage.astro";
import PublicLayout from "@/layouts/PublicLayout.astro";

const data = await getEntry("documents", "about")!;

const { Content, headings } = await render(data);

import { ogImageFor } from "@/lib/og/url";
---

<PublicLayout
	title="About Colibri"
	description="Learn more about what Colibri is, why we built it, and why you should use it."
	image={ogImageFor({ kind: "document", id: "about" }, Astro.site)}
	starry
>
	<ProsePage
		title={data.data.title}
		description={data.data.description}
		headings={headings}
	>
		<Content />
	</ProsePage>
</PublicLayout>
