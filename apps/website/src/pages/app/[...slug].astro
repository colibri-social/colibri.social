---
import { PUBLIC_VAPID_KEY } from "astro:env/client";
import { App } from "@colibri-social/client";
import BaseLayout from "../../layouts/BaseLayout.astro";
import "@colibri-social/assets/fonts.css";
import "@colibri-social/client/index.css";
import "@/styles/emoji-picker.css";
---

<BaseLayout title="Colibri">
	<script define:vars={{ key: PUBLIC_VAPID_KEY }} is:inline>
		if (key) window.__COLIBRI_VAPID_KEY__ = key;
	</script>
	{import.meta.env.PROD && (
		<script>
			import { initSentry } from "@colibri-social/client";
			import { SENTRY_DSN, SENTRY_RELEASE } from "astro:env/client";

			initSentry({
				dsn: SENTRY_DSN,
				release: SENTRY_RELEASE,
				environment: "production",
			});
		</script>
	)}
	<App client:only="solid-js" />
</BaseLayout>
