---
import PostCard from "@/components/public/blog/PostCard.astro";
import PageHeader from "@/components/public/prose/PageHeader.astro";
import PublicLayout from "@/layouts/PublicLayout.astro";
import { BLOG_BASE_URL } from "@/lib/blog/config";
import { listPosts } from "@/lib/blog/posts";

const posts = await listPosts();

import { ogImageFor } from "@/lib/og/url";
---

<PublicLayout
	title="Colibri Blog"
	description="Updates about Colibri Social, the open source chat platform built on atproto."
	image={ogImageFor({ kind: "blog" }, Astro.site)}
	canonical={BLOG_BASE_URL}
	starry
>
	<PageHeader
		title="Blog"
		lead="News and updates about Colibri, the open source chat platform for communities big and small."
		id="blog-title"
	/>

	<section class="posts" aria-labelledby="blog-title">
		<div class="site-wrap">
			{
				posts.length > 0 ? (
					<div class="post-grid">
						{posts.map((post, i) => (
							<PostCard post={post} featured={i === 0} eager={i < 3} />
						))}
					</div>
				) : (
					<p class="posts-empty">No posts yet. Check back soon!</p>
				)
			}
		</div>
	</section>
</PublicLayout>

<style>
	.posts {
		position: relative;
		z-index: 5;
	}

	.post-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 24px;
	}

	.posts .posts-empty {
		margin: 0;
		padding: 48px 0;
		text-align: center;
		color: #a3a3a3;
	}

	@media (max-width: 860px) {
		.post-grid {
			grid-template-columns: minmax(0, 1fr);
		}
	}
</style>
