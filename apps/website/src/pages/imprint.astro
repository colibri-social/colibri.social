---
import { getEntry, render } from "astro:content";
import ProsePage from "@/components/public/prose/ProsePage.astro";
import PublicLayout from "@/layouts/PublicLayout.astro";

const data = await getEntry("documents", "imprint")!;

const { Content, headings } = await render(data);

import { ogImageFor } from "@/lib/og/url";
---

<PublicLayout
	title="Imprint"
	description="Legal information about the operator of colibri.social, as required by § 5 DDG and § 18 MStV."
	image={ogImageFor({ kind: "document", id: "imprint" }, Astro.site)}
	starry
>
	<ProsePage
		title={data.data.title}
		description={data.data.description}
		headings={headings}
	>
		<Content />
	</ProsePage>
</PublicLayout>
