---
import { Image } from "astro:assets";
import AppScreenshot from "@/assets/landing/app-screenshot.png";
import atShield from "@/assets/landing/atShield.webp";
import Branch from "@/assets/landing/branch.webp";
import Colibri from "@/assets/landing/Colibri.png";
import Eye from "@/assets/landing/Eye.png";
import SettingsScreenshot from "@/assets/landing/settings-screenshot.png";
import Tools from "@/assets/landing/Tools.png";
import User from "@/assets/landing/User.png";
import UserVerified from "@/assets/landing/UserVerified.png";
import VcScreenshot from "@/assets/landing/vc-screenshot.png";
import {
	Accordion,
	AccordionContent,
	AccordionItem,
	AccordionTrigger,
} from "@/components/bearnie/accordion";
import Button from "@/components/bearnie/button/Button.astro";
// import Download from "@/components/icons/download.svg";
import GitBranch from "@/components/icons/git-branch.svg";
import Globe from "@/components/icons/globe.svg";
import BinaryMarquee from "@/components/public/BinaryMarquee.astro";
import Clouds from "@/components/public/Clouds.astro";
import HeroDevices from "@/components/public/HeroDevices.astro";
import MockVoiceCall from "@/components/public/MockVoiceCall.tsx";
import PetalField from "@/components/public/nature/PetalField.astro";
import PublicLayout from "@/layouts/PublicLayout.astro";
import { listPosts } from "@/lib/blog/posts";

let latestPost: Awaited<ReturnType<typeof listPosts>>[number] | null = null;
try {
	latestPost = (await listPosts())[0] ?? null;
} catch {
	latestPost = null;
}
---

<PublicLayout
	title="Chats where you truly own your data."
	description="Colibri is an open source chat platform built on the AT protocol for
	communities big and small."
	image="/og.png"
	home
>
	<script is:inline>
		if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
			document.documentElement.classList.add("hero-anim");
		}
	</script>

	<div class="hero-sky" aria-hidden="true"></div>
	<PetalField count={70} />

	<section class="hero relative w-full">
		<div class="hero-fog"></div>
		<div class="hero-petals" aria-hidden="true"></div>

		<div
			class="hero-branch-wrap lg:block hidden"
			data-branch="right"
			data-parallax="0.18"
			aria-hidden="true"
		>
			<canvas
				class="branch-gl"
				data-branch="right"
				data-branch-src={Branch.src}
				data-draw-w="800"
				data-draw-h="519"></canvas>
			<Image
				src={Branch}
				width={800}
				height={519}
				quality={100}
				alt=""
				class="branch-fallback"
				loading="eager"
			/>
			<div class="branch-hit" data-branch-hit="right"></div>
		</div>
		<div
			class="hero-branch-wrap sm:block hidden"
			data-branch="left"
			data-parallax="0.26"
			aria-hidden="true"
		>
			<canvas
				class="branch-gl"
				data-branch="left"
				data-branch-src={Branch.src}
				data-draw-w="800"
				data-draw-h="519"></canvas>
			<Image
				src={Branch}
				width={800}
				height={519}
				quality={100}
				alt=""
				class="branch-fallback"
				loading="eager"
			/>
			<div class="branch-hit" data-branch-hit="left"></div>
		</div>

		<div
			class="hero-inner relative z-20 mx-auto w-full max-w-336 md:px-16 px-6 pt-40 flex flex-col items-center text-center gap-5"
		>
			{
				latestPost && (
					<a
						href={`/blog/${latestPost.rkey}`}
						class="hero-reveal group inline-flex items-center gap-2 max-w-full rounded-full border border-border bg-card px-3 py-1 text-sm text-muted-foreground no-underline transition-colors hover:border-primary/50 hover:text-foreground"
					>
						<span class="shrink-0 font-semibold text-primary">New</span>
						<span class="h-3 w-px shrink-0 bg-border" />
						<span class="truncate">{latestPost.doc.title}</span>
						<span
							aria-hidden="true"
							class="shrink-0 transition-transform relative bottom-px group-hover:translate-x-0.5"
						>
							→
						</span>
					</a>
				)
			}
			<h1 class="hero-title hero-reveal text-5xl md:text-7xl font-black">
				LET YOUR COMMUNITY SPREAD ITS WINGS.
			</h1>
			<p class="hero-sub hero-reveal m-0 max-w-[52ch] text-balance">
				Colibri is an open source chat platform built on the AT protocol for
				communities big and small. Currently in limited early access.
			</p>
			<div
				class="hero-reveal flex flex-row items-start justify-center gap-4 flex-wrap mt-2"
			>
				{
					/*
					<span class="hero-cta inline-flex">
						<Button variant="default" href="/download">
							<Download slot="left-icon" />
							Download
						</Button>
					</span>
					<span class="hero-cta inline-flex">
						<Button variant="secondary" href="/app">
							<Globe slot="left-icon" />
							Open in Browser
						</Button>
					</span>
					*/
				}
				<Button href="/app/waitlist">Join the waitlist</Button>
			</div>
		</div>

		<div class="hero-devices-wrap hero-reveal w-full mt-16 md:mt-20">
			<HeroDevices />
		</div>

		<div class="hero-seam" aria-hidden="true">
			<Clouds />
		</div>
	</section>

	<section class="py-40 mx-auto w-full overflow-hidden relative z-40">
		<div
			class="bg-gradient-dark max-w-304 md:mx-auto mx-6 w-[calc(100%-48px)] md:w-[calc(100%-8rem)] rounded-2xl border border-border flex flex-col h-fit drop-shadow-black/25 drop-shadow-2xl"
		>
			<div
				class="w-full flex flex-col lg:flex-row p-6 border-b border-border gap-6"
			>
				<div class="flex flex-col gap-4 w-full lg:w-[calc(50%-36px)]">
					<small class="text-primary text-sm"> Coming soon. </small>
					<h2 class="text-4xl font-black m-0">OPEN BY DESIGN.</h2>
					<p class="m-0">
						Bluesky is actively building <strong class="text-foreground"
							>permissioned data</strong
						>: a protocol-level way to keep some data private within a space
						instead of broadcasting it to the whole network. Until that ships,
						Colibri stays in <strong class="text-foreground"
							>limited early access</strong
						>: we won't promise private spaces we can't yet secure. The moment
						permissioned data launches, Colibri will too.
					</p>
					<Button href="/app/waitlist">Join the Waitlist</Button>
				</div>
				<div
					class="bg-gradient-feature p-8 rounded-sm h-auto hidden lg:flex items-center justify-center overflow-hidden w-full lg:w-[calc(50%-36px)] ml-auto"
					style="box-shadow: 0 0 5.625px 0 rgba(14, 0, 23, 0.50) inset;"
				>
					<Image
						src={Eye}
						width={200}
						height={200}
						quality={100}
						alt="A white, 3D eye."
						class="z-10"
					/>
				</div>
			</div>
			<div class="w-full h-auto flex flex-col lg:flex-row">
				<div
					class="h-auto w-full flex flex-col gap-12 p-6 border-b lg:border-b-0 border-border border-r"
				>
					<div
						class="bg-gradient-feature p-8 rounded-sm h-92 flex items-center justify-center overflow-hidden"
						style="box-shadow: 0 0 5.625px 0 rgba(14, 0, 23, 0.50) inset;"
					>
						<MockVoiceCall client:visible />
					</div>
					<div class="flex flex-col gap-4">
						<h2 class="text-4xl font-black m-0">
							CHAT, TALK, AND HANG OUT IN REAL TIME.
						</h2>
						<p class="m-0">
							From quick chats and drop-in voice or video calls to organized
							forum discussions, Colibri gives your community the perfect space
							to stay connected and share what matters.
						</p>
					</div>
				</div>
				<div class="h-full w-full flex flex-col">
					<div class="flex flex-col gap-4 p-6 h-full border-b border-border">
						<div
							class="h-30 flex flex-row items-center justify-center relative"
						>
							<Image
								src={atShield}
								width={120}
								height={120}
								alt="A white, 3D shield with 'at://' written on it."
								class="z-10"
							/>
							<BinaryMarquee />
						</div>
						<h2 class="text-4xl font-black m-0">YOU OWN YOUR DATA.</h2>
						<p class="m-0 prose prose-invert prose-neutral">
							Your data isn’t trapped on our servers, it's stored within the
							personal data server that hosts your ATmosphere profile. You can
							check our <a href="/faq">FAQ page</a> for more information.
						</p>
					</div>
					<div class="flex flex-col gap-4 p-6 h-full">
						<div class="h-30 flex flex-row items-center justify-around">
							<div class="w-23 flex items-center justify-center">
								<Image
									src={User}
									width={72}
									height={72}
									alt="A white, 3D User icon."
								/>
							</div>
							<Image
								src={Tools}
								width={120}
								height={120}
								alt="A white 3D-looking hammer and wrench."
							/>
							<Image
								src={UserVerified}
								width={92}
								height={72}
								alt="A white, 3D User icon with a checkmark."
							/>
						</div>
						<h2 class="text-4xl font-black m-0">EASY MOD TOOLING.</h2>
						<p class="m-0">
							Running more than just a group chat? Colibri allows you to easily
							block and remove messages, kick members from your community, and
							stop them from joining again.
						</p>
					</div>
				</div>
			</div>
		</div>
	</section>
	<section class="py-40 mx-auto w-full max-w-336 md:px-16 px-6 relative">
		<Image
			src={Colibri}
			width={240}
			height={240}
			quality={100}
			alt="The Colibri logo, a hummingbird as a 3D-looking icon."
			class="absolute -top-8 transform -scale-x-100 right-0 2lg:-right-36 rotate-5 glide glide-offset"
		/>
		<Image
			src={Colibri}
			width={480}
			height={480}
			quality={100}
			alt="The Colibri logo, a hummingbird as a 3D-looking icon."
			class="absolute -bottom-64 -left-44 rotate-25 glide"
		/>
		<div
			class="w-full rounded-2xl border-border border drop-shadow-black/25 drop-shadow-2xl overflow-hidden p-4 bg-gradient-dark flex flex-col items-center justify-center gap-4"
		>
			<div
				class="w-full flex flex-col gap-4 justify-center p-8 items-center text-center"
			>
				<small class="text-primary text-sm">No need to learn another app.</small
				>
				<h2 class="text-4xl font-black m-0">
					A MODERN, SIMPLE, AND FAMILIAR UI.
				</h2>
				<p class="m-0 max-w-[70ch] text-center">
					Colibri's user interface is inspired by other apps like Discord, Teams
					and Slack. You'll feel right at home with familiar design elements,
					structures, and features.
				</p>
			</div>
			<Image
				src={AppScreenshot}
				width={1920}
				height={1150}
				quality={100}
				data-lightbox
				loading="lazy"
				alt="A screenshot of the Colibri App UI, with a 'General' channel visible, showing a conversation between two users."
				class="rounded-lg border border-border w-full"
			/>
			<div class="grid md:grid-cols-2 grid-cols-1 gap-4">
				<Image
					src={SettingsScreenshot}
					width={1920}
					height={1150}
					quality={100}
					data-lightbox
					loading="lazy"
					alt="A screenshot of the Colibri App UI, with the user settings for the user's profile visible."
					class="rounded-lg border border-border w-full"
				/>
				<Image
					src={VcScreenshot}
					width={1920}
					height={1150}
					quality={100}
					data-lightbox
					loading="lazy"
					alt="A screenshot of the Colibri App UI, with two users in a VC being shown on screen."
					class="rounded-lg border border-border w-full"
				/>
			</div>
		</div>
	</section>
	<section class="py-40 mx-auto w-full max-w-336 md:px-16 px-6 relative z-20">
		<div
			class="bg-gradient-dark w-full rounded-2xl border border-border flex flex-col gap-8 h-fit p-6 relative z-10 items-center drop-shadow-black/25 drop-shadow-2xl"
		>
			<div class="flex flex-col gap-4 items-center text-center">
				<small class="text-primary text-sm">Stuff you might ask about.</small>
				<h2 class="text-4xl font-black m-0">QUESTIONS? WE’VE GOT ANSWERS.</h2>
			</div>
			<Accordion type="single" class="space-y-4 text-foreground">
				<AccordionItem value="item-1" class="border rounded-lg px-4">
					<AccordionTrigger defaultOpen={true}>
						What is the AT Protocol?
					</AccordionTrigger>
					<AccordionContent defaultOpen={true}>
						The AT Protocol (Authenticated Transfer Protocol) is an open,
						decentralized network originally created by the team behind Bluesky.
						It lets you truly own your identity and data - your account, posts,
						and social graph aren't locked into any single platform. With over
						40 million users, it's a growing foundation for the next generation
						of social apps.
					</AccordionContent>
				</AccordionItem>
				<AccordionItem value="item-2" class="border rounded-lg px-4">
					<AccordionTrigger>
						Why is Colibri built on the AT Protocol?
					</AccordionTrigger>
					<AccordionContent>
						We believe your community shouldn't be held hostage by any single
						company. Building on the AT Protocol means your data is portable,
						your identity is yours, and Colibri can't lock you in. If you ever
						want to move, your data comes with you.
					</AccordionContent>
				</AccordionItem>
				<AccordionItem value="item-signup" class="border rounded-lg px-4">
					<AccordionTrigger>Can I sign up right now?</AccordionTrigger>
					<AccordionContent>
						Not yet. Colibri is in <strong class="text-foreground"
							>limited early access</strong
						> while we wait for the AT Protocol to officially support <strong
							class="text-foreground">permissioned data</strong
						>, the upcoming way to keep some data private within a space instead
						of broadcasting it to the whole network. Since private spaces are
						core to what we're building, we're holding off on opening things up
						until that lands. In the meantime, <a href="/app/waitlist"
							>join the waitlist</a
						> and we'll email you the moment there's room.
					</AccordionContent>
				</AccordionItem>
				<AccordionItem value="item-3" class="border rounded-lg px-4">
					<AccordionTrigger> Where is my data stored? </AccordionTrigger>
					<AccordionContent>
						<p class="m-0">
							Your data is stored on the personal data server that hosts your
							profile. On the AT protocol, each user has their own profile that
							isn't specific to any app or service. You can use it to log in
							anywhere! Because of this, you need a single source of truth that
							handles logins and data storage for you. The server that does this
							for you is called your personal data server, or PDS.
						</p>
						<p class="mb-0">
							If you've previously signed up to Bluesky, they will currently be
							hosting your PDS for you. But it's easy to migrate to a{" "}
							<a href="https://atproto.com/guides/self-hosting"
								>self-hosted PDS</a
							>{" "}
							as well! Tools like <a href="https://pdsmoover.com/">PDS MOOver</a
							>{" "}
							can help you migrate your data to your own servers when you are ready
							to.
						</p>
					</AccordionContent>
				</AccordionItem>
				<AccordionItem value="item-3" class="border rounded-lg px-4">
					<AccordionTrigger>
						Can I use my Bluesky account with Colibri?
					</AccordionTrigger>
					<AccordionContent>
						Yes! Since Colibri is built on the same AT Protocol that powers
						Bluesky, you can sign in with your existing Bluesky handle. No need
						to create a new account - your identity carries over seamlessly.
						Note that Colibri is currently in limited early access, so sign-in
						is invite-only for now. <a href="/app/waitlist">Join the waitlist</a
						> and we'll let you in soon.
					</AccordionContent>
				</AccordionItem>
				<AccordionItem value="item-4" class="border rounded-lg px-4">
					<AccordionTrigger>
						Can I use my private PDS account?
					</AccordionTrigger>
					<AccordionContent>
						Absolutely. If you're running your own Personal Data Server, Colibri
						works with it out of the box. Just sign in with your handle or DID
						and we'll connect to your PDS directly. You stay in full control of
						where your data lives - that's the whole point of the AT Protocol.
					</AccordionContent>
				</AccordionItem>
				<AccordionItem value="item-5" class="border rounded-lg px-4">
					<AccordionTrigger>
						Do you host a PDS if I want a new account or move my data over to
						you?
					</AccordionTrigger>
					<AccordionContent>
						We do, though new accounts aren't open yet while we're in limited
						early access. Once we open up, you'll be able to create an account
						or use a tool like <a href="https://pdsmoover.com/">PDS MOOver</a> to
						migrate your data over. Our PDS is hosted at colibri.social. For now,
						<a href="/app/waitlist">join the waitlist</a>, and feel free to
						reach out to <a
							href="https://bsky.app/profile/colibri.social"
							target="_blank"
							rel="noreferrer"
						>
							@colibri.social on Bluesky
						</a> with any questions.
					</AccordionContent>
				</AccordionItem>
				<AccordionItem value="item-7" class="border rounded-lg px-4">
					<AccordionTrigger
						>Do my messages show up as posts on Bluesky?</AccordionTrigger
					>
					<AccordionContent>
						No, they don't. While we store data the same way Bluesky does, we
						use a different "collection", meaning your data will stay confined
						to Colibri. You can use a tool like{" "}
						<a href="https://atproto.at">atproto.at</a> to inspect your profile and
						all related data.
					</AccordionContent>
				</AccordionItem>
			</Accordion>
		</div>
	</section>
</PublicLayout>
<style>
	.hero {
		display: flex;
		flex-direction: column;
		align-items: center;
		padding-bottom: 7rem;
		overflow-x: clip;
	}

	.hero-sky {
		position: absolute;
		top: 0;
		left: 0;
		right: 0;
		height: 100vh;
		z-index: -2;
		pointer-events: none;
		background:
			radial-gradient(
				90% 55% at 50% 10%,
				rgba(134, 102, 255, 0.16) 0%,
				rgba(134, 102, 255, 0) 60%
			),
			linear-gradient(180deg, #17112b 0%, #100d1a 45%, var(--background) 100%);
	}

	.hero-fog {
		position: absolute;
		left: 50%;
		top: 34%;
		width: 85%;
		height: 70%;
		transform: translateX(-50%);
		background: radial-gradient(
			closest-side,
			rgba(134, 102, 255, 0.3) 0%,
			rgba(134, 102, 255, 0.12) 40%,
			rgba(134, 102, 255, 0) 74%
		);
		opacity: 0.85;
		z-index: 0;
		pointer-events: none;
	}

	.hero-petals {
		position: absolute;
		inset: 0;
		z-index: 15;
		pointer-events: none;
		overflow: visible;
	}

	:global(.phys-petal) {
		position: absolute;
		top: 0;
		left: 0;
		will-change: transform, opacity;
	}

	:global(.phys-petal svg) {
		display: block;
		width: 100%;
		height: 100%;
	}

	.hero-branch-wrap {
		--bmx: 200px;
		--bmy: 70px;
		position: absolute;
		z-index: 10;
		pointer-events: none;
		width: calc(800px + 2 * var(--bmx));
		height: calc(519px + 2 * var(--bmy));
	}

	.hero-branch-wrap[data-branch="right"] {
		right: calc(-16rem - var(--bmx));
		top: calc(-1rem - var(--bmy));
	}

	.hero-branch-wrap[data-branch="left"] {
		left: calc(-28rem - var(--bmx));
		top: calc(8rem - var(--bmy));
	}

	.branch-gl {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		display: none;
		pointer-events: none;
	}

	.branch-fallback {
		position: absolute;
		top: var(--bmy);
		left: var(--bmx);
	}

	.hero-branch-wrap[data-branch="left"] .branch-fallback {
		transform: scaleX(-1);
	}

	.branch-hit {
		position: absolute;
		pointer-events: none;
	}

	.hero-branch-wrap[data-branch="right"] .branch-hit {
		top: calc(var(--bmy) + 8rem);
		left: var(--bmx);
		width: 24rem;
		height: 15rem;
	}

	.hero-branch-wrap[data-branch="left"] .branch-hit {
		top: calc(var(--bmy) + 8rem);
		right: var(--bmx);
		width: 24rem;
		height: 15rem;
	}

	.hero-inner::before {
		content: "";
		position: absolute;
		inset: -3rem -6rem -10rem;
		z-index: -1;
		pointer-events: none;
		background: radial-gradient(
			58% 66% at 50% 50%,
			rgba(16, 13, 26, 0.82) 0%,
			rgba(16, 13, 26, 0.55) 46%,
			rgba(16, 13, 26, 0) 78%
		);
	}

	.hero-title {
		margin: 0;
		line-height: 1.02;
		max-width: 18ch;
	}

	.hero-eyebrow,
	.hero-sub {
		text-shadow: 0 1px 14px rgba(16, 13, 26, 0.65);
	}

	.hero-devices-wrap {
		position: relative;
		z-index: 5;
	}

	.hero-seam {
		position: absolute;
		left: 0;
		right: 0;
		bottom: -4rem;
		height: 12rem;
		z-index: 30;
		pointer-events: none;
	}

	.hero-seam :global(> div) {
		position: absolute;
		left: 0;
		right: 0;
		bottom: -32rem;
		top: auto;
		width: 100%;
		transform: none;
		z-index: 30;
	}

	.glide {
		animation: glide 8s ease-in-out infinite;
		transform-origin: center center;
	}

	.glide-offset {
		animation-delay: -1.5s;
	}

	@keyframes glide {
		0% {
			transform: translateY(0px) rotate(var(--tw-rotate, 0deg));
		}
		25% {
			transform: translateY(-12px) rotate(calc(var(--tw-rotate, 0deg) - 3deg));
		}
		50% {
			transform: translateY(4px) rotate(calc(var(--tw-rotate, 0deg) + 2deg));
		}
		75% {
			transform: translateY(-8px) rotate(calc(var(--tw-rotate, 0deg) - 1.5deg));
