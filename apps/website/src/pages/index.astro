---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import AppMock from "@/assets/landing/app-mock.png";
import Branch from "@/assets/landing/branch.webp";
import Grin from "@/assets/landing/grin.webp";
import Kira from "@/assets/landing/kira.webp";
import MilkyWayCard from "@/assets/landing/milkyway-card.webp";
import MilkyWayWide from "@/assets/landing/milkyway-wide.webp";
import PhoneMock from "@/assets/landing/phone-mock.webp";
import ChannelTour from "@/components/public/landing/ChannelTour.astro";
import EmojiRain from "@/components/public/landing/EmojiRain.astro";
import MediaStack from "@/components/public/landing/MediaStack.astro";
import MockVoiceCall from "@/components/public/MockVoiceCall.tsx";
import PetalField from "@/components/public/nature/PetalField.astro";
import PublicLayout from "@/layouts/PublicLayout.astro";
import { getFunding } from "@/lib/funding";

const faq = (await getCollection("faq")).sort((a, b) =>
	a.id.localeCompare(b.id),
);
const funding = await getFunding();

const dollars = (cents: number) =>
	`$${Math.round(cents / 100).toLocaleString("en-US")}`;

const fundingPercent = funding
	? Math.min(100, (funding.monthlyCents / funding.goalCents) * 100)
	: 0;

const milkyWayVars = `--milkyway-wide: url(${MilkyWayWide.src}); --milkyway-card: url(${MilkyWayCard.src});`;

import { ogImageFor } from "@/lib/og/url";
---

<PublicLayout
	title="Chats where you truly own your data."
	description="Colibri is an open source chat platform built on the AT protocol for
	communities big and small."
	image={ogImageFor({ kind: "home" }, Astro.site)}
	home
>
	<div class="landing" style={milkyWayVars}>
		<div class="petal-layer" aria-hidden="true">
			<PetalField count={70} />
		</div>

		<section class="hero">
			<div class="hero-milkyway" aria-hidden="true"></div>
			<div class="hero-petals" aria-hidden="true"></div>

			<div
				class="hero-branch-wrap"
				data-branch="right"
				data-parallax="0.18"
				aria-hidden="true"
			>
				<canvas
					class="branch-gl"
					data-branch="right"
					data-branch-src={Branch.src}
					data-draw-w="800"
					data-draw-h="519"></canvas>
				<Image
					src={Branch}
					width={800}
					height={519}
					quality={100}
					alt=""
					class="branch-fallback"
					loading="eager"
				/>
				<div class="branch-hit" data-branch-hit="right"></div>
			</div>
			<div
				class="hero-branch-wrap"
				data-branch="left"
				data-parallax="0.26"
				aria-hidden="true"
			>
				<canvas
					class="branch-gl"
					data-branch="left"
					data-branch-src={Branch.src}
					data-draw-w="800"
					data-draw-h="519"></canvas>
				<Image
					src={Branch}
					width={800}
					height={519}
					quality={100}
					alt=""
					class="branch-fallback"
					loading="eager"
				/>
				<div class="branch-hit" data-branch-hit="left"></div>
			</div>

			<div class="site-wrap hero-inner">
				<h1 class="hero-title reset">LET YOUR COMMUNITY SPREAD ITS WINGS.</h1>
				<p class="hero-sub">
					Call, chat, and hang out on a platform built for you!
				</p>
				<div class="cta-row">
					<a class="site-btn site-btn-light" data-download href="/download">
						Download Colibri
					</a>
					<a class="site-btn site-btn-dark" href="/app">
						Open Colibri in your browser
					</a>
				</div>
			</div>

			<div class="app-mock">
				<Image
					src={AppMock}
					width={1290}
					height={726}
					densities={[1, 2]}
					quality={100}
					loading="eager"
					alt="The Colibri desktop app showing the general channel of a space called Colibri HQ, with messages, reactions and a member list."
				/>
			</div>
		</section>

		<section class="bento-section" aria-label="Features">
			<div class="site-wrap">
				<div class="bento">
					<article class="card card-row c-bridge">
						<div class="media">
							<p class="placeholder">Abstract bridge UI / Graph</p>
						</div>
						<div class="card-text">
							<h3 class="card-title">Take your old messages with you</h3>
							<p class="card-body">
								Bridge existing content from other platforms so you don’t have
								to leave anything behind. Your entire history is preserved and
								viewable from within Colibri!
							</p>
							<a class="more-link" href="#">
								Get bridging
								<svg viewBox="0 0 24 24" aria-hidden="true"
									><path d="M9 5L15 12L9 19"></path></svg
								>
							</a>
						</div>
					</article>

					<article class="card c-emoji">
						<div class="media">
							<EmojiRain />
						</div>
						<div class="card-text">
							<h3 class="card-title">Express yourself</h3>
							<p class="card-body">
								Colibri supports custom emoji, static and animated, without you
								having to pay for either. Make packs and share them with
								friends!
							</p>
						</div>
					</article>

					<article class="card c-phone">
						<div class="media">
							<Image
								src={PhoneMock}
								widths={[400, 800, 1200]}
								sizes="(max-width: 600px) 80vw, (max-width: 900px) 45vw, 380px"
								alt="The Colibri app on a phone, showing a conversation in a channel called general."
								class="phone-mock"
							/>
						</div>
						<div class="card-text">
							<h3 class="card-title">Made for your phone</h3>
							<p class="card-body">
								Currently on the go? We’ve got first-party apps for Android and
								iOS, so you can take your conversations with you.
							</p>
						</div>
					</article>

					<article class="card c-files">
						<div class="media">
							<MediaStack />
						</div>
						<div class="card-text">
							<h3 class="card-title">Share your memes and compilations</h3>
							<p class="card-body">
								Upload images, videos, PDFs, and GIFs powered by our GIF picker
								to add some spice to your conversations.<br />Yes, that doge is
								very cute.
							</p>
						</div>
					</article>

					<article class="card c-channels">
						<div class="media">
							<ChannelTour />
						</div>
						<div class="card-text">
							<h3 class="card-title">Jump in and out of conversations</h3>
							<p class="card-body">
								Create channels for chatting, one for sharing images, have two
								voice channels for your gaming sessions, and create threads when
								it’s going a bit too much off-topic.
							</p>
						</div>
					</article>

					<article class="card card-row c-voice">
						<div class="card-text">
							<h3 class="card-title">Get chatty</h3>
							<p class="card-body">
								Hop into a voice channel and get talking! Turn on your camera
								for those reading sessions, or share your screen in high
								resolution for some gaming sessions.
							</p>
						</div>
						<div class="media">
							<div class="voice-scale" aria-hidden="true">
								<MockVoiceCall client:visible />
							</div>
						</div>
					</article>
				</div>
			</div>
		</section>

		<section class="support" aria-labelledby="support-title">
			<div class="support-milkyway" aria-hidden="true"></div>
			<div class="site-wrap split">
				<div class="split-text">
					<h2 class="h2" id="support-title">
						Colibri is made possible by people <span class="gold">like you</span
						>.
					</h2>
					<p class="lead">
						Colibri is free, open source software that anyone can use. Your
						contributions help us pay for fixes, updates and the infrastructure
						around the globe. Every amount helps, and you can get an in-app
						badge for supporting us.
					</p>
					{
						funding && (
							<div class="progress">
								<div class="progress-top">
									<span>{dollars(funding.monthlyCents)} raised per month</span>
									<span>Goal: {dollars(funding.goalCents)}</span>
								</div>
								<div
									class="progress-bar"
									role="progressbar"
									aria-valuemin="0"
									aria-valuemax={funding.goalCents / 100}
									aria-valuenow={funding.monthlyCents / 100}
									aria-label="Monthly funding goal"
								>
									<div
										class="progress-fill"
										style={`width: ${fundingPercent}%`}
									/>
								</div>
								<span>
									By {funding.contributors}{" "}
									{funding.contributors === 1 ? "contributor" : "contributors"}
								</span>
							</div>
						)
					}
				</div>

				<div class="support-card" data-support-card>
					<div class="seg-group">
						<div class="seg" role="group" aria-label="How often">
							<button type="button" data-freq="month" aria-pressed="true"
								>Monthly</button
							>
							<button type="button" data-freq="once" aria-pressed="false"
								>One-time</button
							>
						</div>
						<div class="seg" role="group" aria-label="Amount">
							<button type="button" data-amount="5" aria-pressed="false"
								>$5</button
							>
							<button type="button" data-amount="10" aria-pressed="true"
								>$10</button
							>
							<button type="button" data-amount="25" aria-pressed="false"
								>$25</button
							>
						</div>
					</div>
					<div class="profile" aria-live="polite">
						<Image
							src={Kira}
							width={52}
							height={52}
							quality={100}
							alt=""
							class="profile-avatar"
						/>
						<div class="profile-main">
							<div class="profile-name">
								<strong>Kira</strong>
								<span class="badge" data-support-badge style="background: #e870df"
									>$10 SUPPORTER</span
								>
							</div>
							<div class="profile-status">
								<Image src={Grin} width={18} height={18} alt="" quality={100} />
								<span data-support-status
									>I’m supporting Colibri with $10 per month!</span
								>
							</div>
						</div>
					</div>
					<div class="support-actions">
						<a
							class="site-btn site-btn-primary"
							data-support-link
							href="https://opencollective.com/colibri-social/donate?interval=month&amount=10"
							target="_blank"
							rel="noreferrer">Support on Open Collective</a
						>
						<a
							class="site-btn support-secondary"
							href="https://github.com/sponsors/colibri-social"
							target="_blank"
							rel="noreferrer">Support on GitHub Sponsors</a
						>
					</div>
				</div>
			</div>
		</section>

		<section class="atproto" aria-labelledby="atproto-title">
			<div class="site-wrap split">
				<div class="media">
					<p class="placeholder">Abstract PDS / ATproto graphic?</p>
				</div>
				<div class="split-text">
					<h2 class="h2" id="atproto-title">
						Built so your messages <span class="gold">stay with you</span>
					</h2>
					<p class="lead">
						Colibri is built on an emerging technology called the AT Protocol. It
						allows you to move your account to wherever you want, without losing
						ownership over the messages you’ve sent.
					</p>
					<a class="more-link" href="#">
						Read our explainer article
						<svg viewBox="0 0 24 24" aria-hidden="true"
							><path d="M9 5L15 12L9 19"></path></svg
						>
					</a>
				</div>
			</div>
		</section>

		<section class="cta-section" aria-labelledby="cta-title">
			<div class="site-wrap">
				<div class="cta">
					<div class="cta-milkyway" aria-hidden="true"></div>
					<canvas class="cta-stars" data-cta-stars aria-hidden="true"></canvas>
					<div class="cta-inner">
						<h2 class="cta-title" id="cta-title">Are you ready to take off?</h2>
						<p class="cta-sub">
							Join Colibri today, create a space for you and your friends, and
							get chatting on a platform that’s made for you!
						</p>
						<div class="cta-row">
							<a class="site-btn site-btn-light" data-download href="/download">
								Download Colibri
							</a>
							<a class="site-btn site-btn-dark" href="/app">
								Open Colibri in your browser
							</a>
						</div>
					</div>
				</div>
			</div>
		</section>

		<section class="faq-section" id="faq" aria-labelledby="faq-title">
			<div class="site-wrap">
				<h2 class="faq-title" id="faq-title">
					Still got questions? Maybe we can help you!
				</h2>
				<div class="faq" data-faq>
					{
						faq.map((item, i) => (
							<details name="faq" open={i === 0}>
								<summary>
									{item.data.question}
									<svg viewBox="0 0 24 24" aria-hidden="true">
										<path d="M19 9L12 15L5 9" />
									</svg>
								</summary>
								<p class="faq-answer">{item.data.answer}</p>
							</details>
						))
					}
				</div>
			</div>
		</section>
	</div>
</PublicLayout>

<style>
	.landing {
		position: relative;
		color: #fff;
		font-family: var(--font-sans);
		font-weight: 500;
		--t-hero: clamp(40px, 6.2vw, 88px);
		--t-h2: clamp(30px, 3.3vw, 44px);
		--t-cta: clamp(34px, 4.2vw, 58px);
		--t-lead: clamp(17px, 1.35vw, 21px);
		--t-card-title: clamp(20px, 1.4vw, 22px);
		--t-card-body: clamp(16px, 1.1vw, 18px);
		--mock-w: min(1290px, calc(100vw - 32px));
	}

	.landing :is(h1, h2, h3, p) {
		margin: 0;
		color: #fff;
		background: none;
		-webkit-text-fill-color: currentColor;
		letter-spacing: normal;
		text-wrap: balance;
	}

	.landing p {
		text-wrap: wrap;
	}

	.landing :is(h2, h3) {
		font-family: var(--font-sans);
	}

	.petal-layer {
		position: absolute;
		inset: 0 0 calc(-1 * var(--footer-height, 0px));
		z-index: 1;
		pointer-events: none;
	}

	.hero {
		position: relative;
		display: flow-root;
		padding-top: clamp(132px, 15vw, 210px);
		background:
			linear-gradient(rgba(0, 0, 0, 0.1), rgba(0, 0, 0, 0.1)),
			radial-gradient(var(--mw-hero-rx) 100% at 50% 100%, var(--mw));
	}

	.hero-milkyway {
		position: absolute;
		inset: 0;
		background: radial-gradient(var(--mw-hero-rx) 100% at 50% 100%, var(--mw-glow)), #d9d9d9;
		-webkit-mask: var(--milkyway-wide) center / cover no-repeat;
		mask: var(--milkyway-wide) center / cover no-repeat;
		pointer-events: none;
	}

	.hero-petals {
		position: absolute;
		inset: 0;
		z-index: 6;
		pointer-events: none;
		overflow-x: clip;
		overflow-y: visible;
	}

	:global(.phys-petal) {
		position: absolute;
		top: 0;
		left: 0;
		will-change: transform, opacity;
	}

	:global(.phys-petal svg) {
		display: block;
		width: 100%;
		height: 100%;
	}

	.hero-branch-wrap {
		--bmx: 200px;
		--bmy: 70px;
		position: absolute;
		z-index: 3;
		pointer-events: none;
		width: calc(800px + 2 * var(--bmx));
		height: calc(519px + 2 * var(--bmy));
	}

	.hero-branch-wrap[data-branch="right"] {
		right: calc(-286px - var(--bmx));
		top: calc(256px - var(--bmy));
	}

	.hero-branch-wrap[data-branch="left"] {
		left: calc(-345px - var(--bmx));
		top: calc(170px - var(--bmy));
	}

	.branch-gl {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		display: none;
		pointer-events: none;
	}

	.branch-fallback {
		position: absolute;
		top: var(--bmy);
		left: var(--bmx);
		max-width: none;
	}

	.hero-branch-wrap[data-branch="left"] .branch-fallback {
		transform: scaleX(-1);
	}

	.branch-hit {
		position: absolute;
		pointer-events: none;
		top: calc(var(--bmy) + 8rem);
		width: 24rem;
		height: 15rem;
	}

	.hero-branch-wrap[data-branch="right"] .branch-hit {
		left: var(--bmx);
	}

	.hero-branch-wrap[data-branch="left"] .branch-hit {
		right: var(--bmx);
	}

	@media (max-width: 1023px) {
		.hero-branch-wrap[data-branch="right"] {
			display: none;
		}
	}

	@media (max-width: 639px) {
		.hero-branch-wrap[data-branch="left"] {
			display: none;
		}
	}

	.hero-inner {
		z-index: 5;
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
	}

	.hero-inner::before {
		content: "";
		position: absolute;
		inset: -3rem -6rem -6rem;
		z-index: -1;
		pointer-events: none;
		background: radial-gradient(
			58% 66% at 50% 50%,
			rgba(16, 13, 26, 0.55) 0%,
			rgba(16, 13, 26, 0.32) 46%,
			rgba(16, 13, 26, 0) 78%
		);
	}

	.landing .hero-title {
		max-width: 22ch;
		font-family: var(--font-stardom);
		font-weight: 400;
		font-size: var(--t-hero);
		line-height: 0.86;
		letter-spacing: 0.005em;
		text-shadow:
			0 0 16px rgba(0, 0, 0, 0.5),
			0 2px 28px rgba(16, 13, 26, 0.6);
	}

	.landing .hero-sub {
		margin-top: clamp(28px, 3.4vw, 52px);
		font-size: clamp(18px, 1.3vw, 22px);
		text-shadow: 0 1px 14px rgba(16, 13, 26, 0.45);
	}

	.cta-row {
		margin-top: 32px;
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 16px;
	}

	.app-mock {
		position: relative;
		z-index: 5;
		width: var(--mock-w);
		margin: clamp(72px, 7vw, 132px) auto calc(var(--mock-w) * -0.2667);
	}

	.app-mock img {
		display: block;
		width: 100%;
		height: auto;
	}

	.bento-section {
		position: relative;
		padding-top: calc(var(--mock-w) * 0.2667 + clamp(64px, 6vw, 112px));
		padding-bottom: 128px;
	}

	.bento-section .site-wrap {
		z-index: 5;
	}

	.bento {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		grid-template-areas:
			"bridge bridge emoji"
			"phone files channels"
			"phone voice voice";
		gap: 24px;
	}

	.card {
		position: relative;
		min-width: 0;
		display: flex;
		flex-direction: column;
		gap: 24px;
		padding: 20px;
		border-radius: 20px;
		background: var(--site-card);
		border: 1px solid var(--site-line);
		overflow: hidden;
	}

	.card-row {
		flex-direction: row;
		gap: 32px;
	}

	.card-row > * {
		flex: 1 1 0;
		min-width: 0;
	}

	.card-text {
		display: flex;
		flex-direction: column;
		justify-content: center;
		gap: 20px;
	}

	.landing .card-title {
		font-weight: 900;
		font-size: var(--t-card-title);
		line-height: 1.05;
	}

	.landing .card-body {
		font-size: var(--t-card-body);
		line-height: 1.35;
	}

	.media {
		position: relative;
		display: grid;
		place-items: center;
		border-radius: 10px;
		overflow: hidden;
		background: radial-gradient(182% 100% at 50% 100%, var(--mw)), #171717;
	}

	.landing .placeholder {
		padding: 0 12px;
		font-family: "Comic Sans MS", "Chalkboard SE", cursive;
		font-weight: 700;
		font-size: 19px;
		line-height: 1;
		text-align: center;
		background: linear-gradient(
			90deg,
			#ff0000 0%,
			#ffc300 17.8%,
			#00ffb7 37.5%,
			#0066ff 74%,
			#ff00a1 100%
		);
		-webkit-background-clip: text;
		background-clip: text;
		-webkit-text-fill-color: transparent;
	}

	.more-link {
		display: inline-flex;
		align-items: center;
		gap: 4px;
		width: fit-content;
		font-weight: 600;
		font-size: clamp(17px, 1.2vw, 19px);
		color: #fff;
		text-decoration: none;
		text-decoration-thickness: 1.5px;
		text-underline-offset: 5px;
	}

	.more-link:hover {
		text-decoration: underline;
	}

	.more-link svg {
		width: 16px;
		height: 16px;
		flex: none;
		fill: none;
		stroke: currentColor;
		stroke-width: 1.5;
		stroke-linecap: round;
		stroke-linejoin: round;
		transition: transform 0.15s;
	}

	.more-link:hover svg {
		transform: translateX(3px);
	}

	.c-bridge {
		grid-area: bridge;
	}

	.c-bridge .media {
		min-height: 240px;
	}

	.c-emoji {
		grid-area: emoji;
	}

	.c-emoji .media {
		height: 150px;
		flex: none;
	}

	.c-phone {
		grid-area: phone;
	}

	.c-phone .media {
		flex: 1 1 auto;
		min-height: 200px;
	}

	.c-phone :global(.phone-mock) {
		position: absolute;
		inset: 16px 0 0;
		width: 100%;
		height: calc(100% - 16px);
		object-fit: contain;
		object-position: center bottom;
	}

	.c-files {
