---
import PublicLayout from "@/layouts/PublicLayout.astro";

const { code } = Astro.params;

if (!code) return Astro.redirect("/");
---

<PublicLayout
	title="You've been invited to join a community on Colibri!"
	description="Open Colibri to accept your invitation."
>
	<section
		class="py-40 mx-auto w-full max-w-336 md:px-16 px-6 relative flex flex-col items-center gap-6 text-center"
		id="loading-section"
		data-code={code}
	>
		<h1 class="text-3xl font-black m-0">Opening Colibri...</h1>
		<p class="m-0 text-muted-foreground">
			If nothing happens, <a class="text-primary" href={`/app/invite/${code}`}
				>click here</a
			> to continue.
		</p>
	</section>
</PublicLayout>
<script>
	const code =
		document.querySelector<HTMLElement>("#loading-section")?.dataset.code;
	const PENDING_INVITE_KEY = "colibri:pending-invite";

	if (!code) throw new Error("Unable to get code");

	try {
		localStorage.setItem(PENDING_INVITE_KEY, code);
	} catch {}

	// TODO(app): Once native desktop/mobile apps exist, first try to open them
	// via a registered deep link (e.g. `colibri://invite/${code}`) and only fall
	// back to the web app below if that fails. No protocol scheme is registered
	// yet, so we always open the web app for now.

	window.location.replace(`/app/invite/${code}`);
</script>
