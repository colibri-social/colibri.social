---
import PublicLayout from "@/layouts/PublicLayout.astro";

const { code } = Astro.params;

if (!code) return Astro.redirect("/");
---

<PublicLayout
	title="You've been invited to join a community on Colibri!"
	description="Open Colibri to accept your invitation."
>
	<section
		class="py-40 mx-auto w-full max-w-336 md:px-16 px-6 relative flex flex-col items-center gap-6 text-center"
		id="loading-section"
		data-code={code}
	>
		<h1 class="text-3xl font-black m-0">Opening Colibri...</h1>
		<p class="m-0 text-muted-foreground">
			If nothing happens, <a class="text-primary" href={`/app/invite/${code}`}
				>click here</a
			> to continue.
		</p>
	</section>
</PublicLayout>
<script>
	const code =
		document.querySelector<HTMLElement>("#loading-section")?.dataset.code;
	const PENDING_INVITE_KEY = "colibri:pending-invite";

	if (!code) throw new Error("Unable to get code");

	try {
		localStorage.setItem(PENDING_INVITE_KEY, code);
	} catch {}

	const encoded = encodeURIComponent(code);
	const scheme = window.location.hostname.split(".").reverse().join(".");
	const webUrl = `/app/invite/${encoded}`;
	const nativeUrl = `${scheme}:/invite/${encoded}`;

	let handedOffToApp = false;
	const markHandedOff = () => {
		handedOffToApp = true;
	};

	document.addEventListener("visibilitychange", () => {
		if (document.visibilityState === "hidden") handedOffToApp = true;
	});
	window.addEventListener("pagehide", markHandedOff);
	window.addEventListener("blur", markHandedOff);

	window.setTimeout(() => {
		if (!handedOffToApp && document.visibilityState === "visible") {
			window.location.replace(webUrl);
		}
	}, 2000);

	try {
		window.location.href = nativeUrl;
	} catch {
		window.location.replace(webUrl);
	}
</script>
