---
import { getEntry, render } from "astro:content";
import ProsePage from "@/components/public/prose/ProsePage.astro";
import PublicLayout from "@/layouts/PublicLayout.astro";

const data = await getEntry("documents", "privacy")!;

const { Content, headings } = await render(data);

import { ogImageFor } from "@/lib/og/url";
---

<PublicLayout
	title="Privacy Policy"
	description="How Colibri processes personal data, what leaves your device, and the rights you have under the GDPR."
	image={ogImageFor({ kind: "document", id: "privacy" }, Astro.site)}
	starry
>
	<ProsePage
		title={data.data.title}
		description={data.data.description}
		headings={headings}
	>
		<Content />
	</ProsePage>
</PublicLayout>
