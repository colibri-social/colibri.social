---
import { getEntry, render } from "astro:content";
import ProsePage from "@/components/public/prose/ProsePage.astro";
import PublicLayout from "@/layouts/PublicLayout.astro";

const data = await getEntry("documents", "support")!;

const { Content, headings } = await render(data);

import { ogImageFor } from "@/lib/og/url";
---

<PublicLayout
	title="Support"
	description="How to get help with Colibri, report a bug, or reach the people behind it."
	image={ogImageFor({ kind: "document", id: "support" }, Astro.site)}
	starry
>
	<ProsePage
		title={data.data.title}
		description={data.data.description}
		headings={headings}
	>
		<Content />
	</ProsePage>
</PublicLayout>
