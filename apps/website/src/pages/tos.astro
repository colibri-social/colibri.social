---
import { getEntry, render } from "astro:content";
import ProsePage from "@/components/public/prose/ProsePage.astro";
import PublicLayout from "@/layouts/PublicLayout.astro";

const data = await getEntry("documents", "tos")!;

const { Content, headings } = await render(data);

import { ogImageFor } from "@/lib/og/url";
---

<PublicLayout
	title="Terms of Service"
	description="The terms governing your use of the hosted Colibri service, including acceptable use, liability, and governing law."
	image={ogImageFor({ kind: "document", id: "tos" }, Astro.site)}
	starry
>
	<ProsePage
		title={data.data.title}
		description={data.data.description}
		headings={headings}
	>
		<Content />
	</ProsePage>
</PublicLayout>
