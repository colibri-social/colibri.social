{
	"lexicon": 1,
	"id": "social.colibri.actor.getNotificationPreference",
	"defs": {
		"main": {
			"type": "query",
			"description": "Returns the authenticated user's notification level, defaulting to 'all' when they haven't set one.",
			"output": {
				"encoding": "application/json",
				"schema": {
					"type": "object",
					"required": [
						"level"
					],
					"properties": {
						"level": {
							"type": "string",
							"knownValues": [
								"all",
								"mentionsAndReplies"
							]
						}
					}
				}
			}
		}
	}
}
