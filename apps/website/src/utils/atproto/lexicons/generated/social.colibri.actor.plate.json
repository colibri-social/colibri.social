{
	"lexicon": 1,
	"id": "social.colibri.actor.plate",
	"revision": 1,
	"defs": {
		"main": {
			"description": "A Colibri name plate used to decorate member rows.",
			"key": "tid",
			"record": {
				"properties": {
					"$type": {
						"type": "string",
						"description": "The type of the record.",
						"format": "nsid"
					},
					"name": {
						"type": "string",
						"maxGraphemes": 32,
						"maxLength": 320,
						"description": "Plate name as exposed to the user."
					},
					"color": {
						"type": "string",
						"maxLength": 7,
						"description": "The base plate color, blended with the image."
					},
					"picture": {
						"type": "blob",
						"description": "The plate image, blended with the color.",
						"accept": [
							"image/jpeg",
							"image/png",
							"image/gif",
							"image/webp"
						]
					}
				},
				"required": [
					"name",
					"color",
					"picture"
				],
				"type": "object"
			},
			"type": "record"
		}
	}
}
