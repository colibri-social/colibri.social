					"authority": "*",
					"action": [
						"read"
					],
					"manage": [
						"create",
						"update",
						"delete"
					]
				},
				{
					"type": "permission",
					"resource": "space",
					"spaceType": "social.colibri.beta.channel.voice",
					"authority": "*",
					"action": [
						"read"
					],
					"manage": [
						"create",
						"update",
						"delete"
