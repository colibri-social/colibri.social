{
	"lexicon": 1,
	"id": "social.colibri.channel.listMessages",
	"defs": {
		"main": {
			"type": "query",
			"description": "Lists messages in a channel, newest first, paginated.",
			"parameters": {
				"type": "params",
				"required": [
					"channel"
				],
				"properties": {
					"channel": {
						"type": "string",
						"format": "at-uri"
					},
					"limit": {
						"type": "integer"
					},
					"cursor": {
						"type": "string"
					},
					"all": {
						"type": "boolean",
						"description": "Include hidden (moderated) messages."
					}
				}
			},
			"output": {
				"encoding": "application/json",
				"schema": {
					"type": "object",
					"required": [
						"messages"
					],
					"properties": {
						"cursor": {
							"type": "string"
						},
						"messages": {
							"type": "array",
							"items": {
								"type": "ref",
								"ref": "lex:social.colibri.channel.defs#message"
							}
						}
					}
				}
			}
		}
	}
}
