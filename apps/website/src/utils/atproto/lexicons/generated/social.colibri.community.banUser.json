{
	"lexicon": 1,
	"id": "social.colibri.community.banUser",
	"defs": {
		"main": {
			"type": "procedure",
			"description": "Bans a user from a community.",
			"parameters": {
				"type": "params",
				"required": [
					"community",
					"identifier"
				],
				"properties": {
					"community": {
						"type": "string",
						"format": "at-uri"
					},
					"identifier": {
						"type": "string",
						"description": "DID or handle of the user to ban."
					}
				}
			},
			"output": {
				"encoding": "application/json",
				"schema": {
					"type": "object",
					"required": [
						"did",
						"handle"
					],
					"properties": {
						"did": {
							"type": "string",
							"format": "did"
						},
						"handle": {
							"type": "string",
							"format": "handle"
						}
					}
				}
			}
		}
	}
}
