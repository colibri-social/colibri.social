{
	"lexicon": 1,
	"id": "social.colibri.community.registerCredentials",
	"defs": {
		"main": {
			"type": "procedure",
			"description": "Registers bring-your-own PDS credentials for a community DID.",
			"parameters": {
				"type": "params",
				"required": [
					"did",
					"pds",
					"identifier",
					"password"
				],
				"properties": {
					"did": {
						"type": "string",
						"format": "did"
					},
					"pds": {
						"type": "string"
					},
					"identifier": {
						"type": "string"
					},
					"password": {
						"type": "string"
					}
				}
			},
			"output": {
				"encoding": "application/json",
				"schema": {
					"type": "object",
					"required": [
						"did",
						"source"
					],
					"properties": {
						"did": {
							"type": "string",
							"format": "did"
						},
						"source": {
							"type": "string"
						}
					}
				}
			}
		}
	}
}
