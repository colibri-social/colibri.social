{
	"$schema": "https://biomejs.dev/schemas/2.5.2/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true,
		"defaultBranch": "main"
	},
	"files": {
		"ignoreUnknown": false,
		"includes": [
			"apps/website/**",
			"packages/lib/**",
			"packages/client/**",
			"packages/assets/**",
			"!**/dist",
			"!**/.astro",
			"!apps/website/public",
			"!apps/website/src/utils/atproto/lexicons/generated",
			"!packages/assets/files",
			"!packages/assets/src/login-manifest.ts",
			"!packages/client/src/hooks/rnnoise-assets.generated.ts"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab"
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended"
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double"
		}
	},
	"css": {
		"parser": {
			"tailwindDirectives": true
		}
	},
	"assist": {
		"enabled": true,
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	},
	"overrides": [
		{
			"includes": ["**/*.svg"],
			"linter": {
				"rules": {
					"a11y": {
						"noSvgWithoutTitle": "off"
					}
				}
			}
		},
		{
			"includes": ["**/*.css"],
			"linter": {
				"rules": {
					"complexity": {
						"noImportantStyles": "off"
					}
				}
			}
		},
		{
			"includes": ["**/*.ts", "**/*.tsx"],
			"linter": {
				"rules": {
					"style": {
						"noNonNullAssertion": "off"
					},
					"suspicious": {
						"noExplicitAny": "off",
						"noAssignInExpressions": "off",
						"noMisleadingCharacterClass": "off"
					},
					"complexity": {
						"noBannedTypes": "off"
					},
					"a11y": {
						"useKeyWithClickEvents": "off",
						"noStaticElementInteractions": "off",
						"useMediaCaption": "off"
					}
				}
			}
		},
		{
			"includes": ["**/*.astro"],
			"linter": {
				"rules": {
					"style": {
						"useConst": "off",
						"useImportType": "off",
						"noNonNullAssertion": "off"
					},
					"complexity": {
						"noImportantStyles": "off"
					},
					"correctness": {
						"noUnusedVariables": "off",
						"noUnusedImports": "off"
					}
				}
			}
		},
		{
			"includes": ["packages/client/**/*.ts", "packages/client/**/*.tsx"],
			"linter": {
				"rules": {
					"suspicious": {
						"noConsole": "error"
					}
				}
			}
		},
		{
			"includes": [
				"packages/client/src/utils/logger.ts",
				"packages/client/src/utils/dev-diagnostics.ts",
				"packages/client/src/utils/perf.ts",
				"packages/client/**/*.test.ts"
			],
			"linter": {
				"rules": {
					"suspicious": {
						"noConsole": "off"
					}
				}
			}
		}
	]
}
