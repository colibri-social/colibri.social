{
	"scripts": {
		"dev:client": "pnpm --filter @colibri-social/client dev",
		"dev:sandbox": "pnpm --filter @colibri-social/client sandbox",
		"dev:web": "pnpm --filter @colibri-social/website dev",
		"dev:tauri": "pnpm --filter @colibri-social/wrapper tauri dev",
		"dev:tauri:android": "pnpm --filter @colibri-social/wrapper tauri android dev",
		"dev:tauri:ios": "pnpm --filter @colibri-social/wrapper tauri ios dev",
		"build": "pnpm -r build",
		"test": "pnpm -r test",
		"lexicons:export": "pnpm --filter @colibri-social/website lexicons:export",
		"error-codes:generate": "node --experimental-strip-types scripts/generate-error-codes.ts",
		"changeset:feature": "node --experimental-strip-types scripts/changeset-feature.ts",
		"whats-new:check": "node --experimental-strip-types scripts/check-whats-new.ts",
		"whats-new:generate": "node --experimental-strip-types scripts/collect-release-notes.ts generate",
		"whats-new:preview": "node --experimental-strip-types scripts/collect-release-notes.ts preview",
		"typecheck:scripts": "tsc -p tsconfig.scripts.json",
		"lint": "biome check .",
		"lint:fix": "biome check . --write",
		"format": "biome format . --write",
		"biome": "biome",
		"ci:version": "node --experimental-strip-types scripts/collect-release-notes.ts collect && changeset version && node --experimental-strip-types scripts/collect-release-notes.ts finalize && pnpm install --lockfile-only --no-frozen-lockfile"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.2",
		"@changesets/cli": "^2.31.0",
		"@clack/prompts": "^1.7.0",
		"@resvg/resvg-js": "^2.6.2",
		"@types/node": "^25.6.0"
	},
	"type": "module",
	"packageManager": "pnpm@11.17.0+sha512.cca3cea332ad254bb84145f966d19f4879615210346fc92c79a047f23a0d7b3cca3c3792f0076ba1f1831d277efbcf0a9119b31a9a60eca7fb3d6231f331ef72",
	"dependencies": {
		"typescript": "^6.0.3"
	}
}
