		"@sentry/vite-plugin": "^5.3.0",
		"@tailwindcss/vite": "^4.1.18",
		"@vitest/browser": "^4.1.10",
		"@vitest/browser-playwright": "^4.1.10",
		"playwright": "^1.63.0",
		"tailwindcss": "^4.2.4",
		"typescript": "^6.0.3",
		"vite": "^8.1.3",
		"vite-plugin-solid": "^2.11.8",
		"vitest": "^4.1.10"
