{
	"name": "@colibri-social/app",
	"private": true,
	"type": "module",
	"version": "0.0.0",
	"description": "The Colibri Social client, built on the component library.",
	"license": "MIT",
	"exports": {
		"./dist/*": "./dist/*"
	},
	"scripts": {
		"dev": "pnpm --filter @colibri-social/assets build-worklets && vite",
