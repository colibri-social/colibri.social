{
	"name": "@colibri-social/client",
	"version": "0.1.0-rc.15",
	"description": "The Colibri Social client UI, a Solid application shared by the web app and the native shell.",
	"type": "module",
	"homepage": "https://colibri.social",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/colibri-social/colibri.social.git",
		"directory": "packages/client"
	},
	"files": [
		"dist"
	],
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"start": "pnpm --filter @colibri-social/assets fetch-all && vite serve dev",
		"dev": "pnpm --filter @colibri-social/assets fetch-all && vite serve dev",
		"build": "tsdown && tailwindcss -i src/index.css -o dist/index.css --minify && node -e \"require('node:fs').copyFileSync('src/components/hummingbird/hummingbird.css','dist/hummingbird.css')\"",
		"prepack": "pnpm build",
		"test": "vitest run",
		"typecheck": "tsc --noEmit",
		"sandbox": "pnpm --filter @colibri-social/assets fetch-emoji && vite serve dev --open /sandbox.html"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"import": "./dist/index.mjs"
		},
		"./scopes": {
			"types": "./dist/atproto/scopes.d.mts",
			"import": "./dist/atproto/scopes.mjs"
		},
		"./animation": {
			"types": "./dist/hooks/createAnimationTimeline.d.mts",
			"import": "./dist/hooks/createAnimationTimeline.mjs"
		},
		"./hummingbird": {
			"types": "./dist/components/hummingbird/index.d.mts",
			"import": "./dist/components/hummingbird/index.mjs"
		},
		"./index.css": "./dist/index.css",
		"./hummingbird.css": "./dist/hummingbird.css"
	},
	"license": "MIT",
	"devDependencies": {
		"@atproto/lexicon": "^0.6.1",
		"@colibri-social/assets": "workspace:0.0.2-rc.3",
		"@colibri-social/lib": "workspace:0.1.0-rc.6",
		"@iconify-json/lucide": "^1.2.116",
		"@iconify-json/ph": "^1.2.2",
		"@tailwindcss/cli": "^4.2.4",
		"@tailwindcss/vite": "^4.1.18",
		"@types/chroma-js": "^3.1.2",
		"solid-devtools": "^0.34.3",
		"tailwindcss": "^4.2.4",
		"tsdown": "^0.22.14",
		"unplugin-icons": "^23.0.1",
		"unplugin-solid": "^2.0.0",
		"vite": "^7.1.4",
		"vite-plugin-solid": "^2.11.8",
		"vitest": "^4.1.10"
	},
	"dependencies": {
		"@arborium/arborium": "^2.18.1",
		"@atproto/api": "^0.20.22",
		"@atproto/oauth-client-browser": "^0.4.3",
		"@kobalte/core": "^0.13.11",
		"@sapphi-red/web-noise-suppressor": "^0.3.5",
		"@sentry/solid": "^10.63.0",
		"@solid-primitives/websocket": "^1.4.0",
		"@solidjs/router": "^0.16.1",
		"@tailwindcss/typography": "^0.5.20",
		"@tauri-apps/api": "^2.11.1",
		"@tauri-apps/plugin-deep-link": "^2.4.9",
		"@tauri-apps/plugin-dialog": "^2.7.2",
		"@tauri-apps/plugin-fs": "^2.5.1",
		"@tauri-apps/plugin-notification": "^2.3.3",
		"@tauri-apps/plugin-opener": "^2.5.4",
		"@tauri-apps/plugin-os": "^2.3.2",
		"@tauri-apps/plugin-process": "^2.3.1",
		"@tauri-apps/plugin-updater": "^2.10.1",
		"@thisbeyond/solid-dnd": "^0.7.5",
		"@tiptap/core": "^3.20.1",
		"@tiptap/extension-blockquote": "3.20.1",
		"@tiptap/extension-bold": "^3.20.1",
		"@tiptap/extension-bubble-menu": "^3.20.1",
		"@tiptap/extension-code": "^3.20.1",
		"@tiptap/extension-code-block": "3.20.1",
		"@tiptap/extension-document": "^3.20.1",
		"@tiptap/extension-emoji": "^3.20.1",
		"@tiptap/extension-hard-break": "^3.20.1",
		"@tiptap/extension-italic": "^3.20.1",
		"@tiptap/extension-link": "^3.20.1",
		"@tiptap/extension-mention": "^3.20.1",
		"@tiptap/extension-paragraph": "^3.20.1",
		"@tiptap/extension-strike": "^3.20.1",
		"@tiptap/extension-text": "^3.20.1",
		"@tiptap/extension-underline": "^3.20.1",
		"@tiptap/extensions": "^3.20.1",
		"@tiptap/suggestion": "^3.20.1",
		"@twemoji/api": "^17.0.3",
		"chroma-js": "^3.2.0",
		"chrono-node": "^2.9.1",
		"cva": "1.0.0-beta.4",
		"deepfilternet3-noise-filter": "^1.3.0",
		"dompurify": "^3.3.3",
		"emojilib": "^4.0.3",
		"json-stable-stringify": "^1.3.0",
		"marqy": "^1.1.0",
		"mdast-util-from-markdown": "^2.0.2",
		"mdast-util-gfm-strikethrough": "^2.0.0",
		"mediasoup-client": "^3.21.0",
		"micromark-extension-gfm-strikethrough": "^2.1.0",
		"prosemirror-history": "^1.5.0",
		"prosemirror-model": "^1.25.9",
		"prosemirror-state": "^1.4.4",
		"prosemirror-view": "^1.41.9",
		"solid-color": "^0.0.9",
		"solid-emoji-picker": "^0.3.0",
		"solid-js": "^1.9.5",
		"solid-tiptap": "^0.8.0",
		"somoto": "^0.0.2",
		"tailwind-merge": "^3.4.0",
		"tauri-plugin-fcm": "^0.2.0",
		"tlds": "^1.261.0",
		"tw-animate-css": "^1.4.0",
		"unicode-emoji-json": "^0.9.0",
		"vidstack": "^1.12.13"
	}
}
