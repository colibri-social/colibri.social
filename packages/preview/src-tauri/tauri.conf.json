{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "Colibri Preview",
	"version": "0.0.1",
	"identifier": "social.colibri.preview",
	"build": {
		"beforeDevCommand": "pnpm --filter @colibri-social/app dev",
		"devUrl": "http://localhost:5173",
		"beforeBuildCommand": "pnpm --filter @colibri-social/app build",
		"frontendDist": "../../app/dist"
	},
	"app": {
		"windows": [
			{
				"label": "main",
				"title": "Colibri Preview",
				"width": 1200,
				"height": 800,
				"minWidth": 768,
				"minHeight": 768,
				"titleBarStyle": "Overlay",
				"hiddenTitle": true,
				"backgroundColor": "#080808"
			}
		],
		"security": {
			"csp": null
		}
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico",
			"icons/Colibri.icon",
			"icons/Assets.car"
		],
		"category": "SocialNetworking",
		"publisher": "Colibri",
		"shortDescription": "Colibri Preview",
		"longDescription": "A preview of the new Colibri client running on mock data.",
		"macOS": {
			"entitlements": "Entitlements.plist",
			"signingIdentity": "-"
		}
	},
	"plugins": {
		"deep-link": {
			"mobile": [
				{
					"scheme": [
						"social.colibri",
						"social.colibri.spaces"
					]
				}
			],
			"desktop": {
				"schemes": [
					"social.colibri",
					"social.colibri.spaces"
				]
			}
		}
	}
}
