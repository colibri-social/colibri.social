---
import type {
	ListItem,
	OrderedListItem,
	ResolveBlob,
	TextBlock,
} from "../src/index.js";
import Block from "./Block.astro";
import List from "./List.astro";
import RichText from "./RichText.astro";

interface Props {
	items: (ListItem | OrderedListItem)[];
	resolveBlob: ResolveBlob;
	ordered?: boolean;
	startIndex?: number;
}

const { items, resolveBlob, ordered = false, startIndex } = Astro.props;
const ListTag = ordered ? "ol" : "ul";
---

<ListTag start={ordered ? startIndex : undefined}>
	{
		items.map((item) => (
			<li class={typeof item.checked === "boolean" ? "list-none" : undefined}>
				{typeof item.checked === "boolean" && (
					<input type="checkbox" checked={item.checked} disabled class="mr-2 align-middle" />
				)}
				{item.content?.$type === "pub.leaflet.blocks.text" ? (
					<RichText
						text={(item.content as TextBlock).plaintext}
						facets={(item.content as TextBlock).facets}
					/>
				) : (
					<Block block={item.content} resolveBlob={resolveBlob} />
				)}
				{item.children && item.children.length > 0 ? (
					<List items={item.children} resolveBlob={resolveBlob} ordered={ordered} />
				) : "orderedListChildren" in item && item.orderedListChildren ? (
					<List
						items={item.orderedListChildren.children ?? []}
						resolveBlob={resolveBlob}
						ordered
						startIndex={item.orderedListChildren.startIndex}
					/>
				) : "unorderedListChildren" in item && item.unorderedListChildren ? (
					<List
						items={item.unorderedListChildren.children ?? []}
						resolveBlob={resolveBlob}
					/>
				) : null}
			</li>
		))
	}
</ListTag>
