{
	"compilerOptions": {
		"composite": true,
		"target": "ES2022",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"lib": ["ES2022", "DOM"],
		"declaration": true,
		"emitDeclarationOnly": true,
		"declarationDir": "dist",
		"rootDir": "src",
		"strict": true,
		"skipLibCheck": true
	},
	"include": ["src/**/*.ts"],
	"exclude": ["node_modules", "dist"]
}
