{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "updater",
  "description": "Updater plugin capability, compiled out for Mac App Store builds.",
  "platforms": ["linux", "macOS", "windows"],
  "windows": ["main"],
  "permissions": [
    "updater:default",
    "process:allow-restart",
    {
      "identifier": "fs:allow-exists",
      "allow": [
        { "path": "/opt/homebrew/Caskroom/colibri-social" },
        { "path": "/usr/local/Caskroom/colibri-social" }
      ]
    }
  ]
}
