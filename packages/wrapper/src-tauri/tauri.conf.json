{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "Colbiri Social",
	"version": "0.1.0",
	"identifier": "social.colibri.app",
	"build": {
		"beforeDevCommand": "pnpm dev",
		"devUrl": "http://127.0.0.1:1420",
		"beforeBuildCommand": "pnpm build",
		"frontendDist": "../dist"
	},
	"app": {
		"windows": [
			{
				"title": "Colibri Social",
				"width": 1200,
				"height": 800,
				"minWidth": 768,
				"minHeight": 768
			}
		],
		"security": {
			"csp": null
		}
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"createUpdaterArtifacts": true,
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		],
		"macOS": {
			"entitlements": "Entitlements.plist"
		}
	},
	"plugins": {
		"updater": {
			"endpoints": [
				"https://colibri.social/{{target}}/{{arch}}/{{current_version}}"
			],
			"pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQ3NkY0NTJDMDNDREY5RkYKUldULytjMERMRVZ2MXhOWGlSTHZJbGFFV1lUbFZBQUJSSmN2VTE1clhmWnEyNjRFd0hFK3AvWkoK"
		},
		"deep-link": {
			"desktop": {
				"schemes": ["social.colibri"]
			}
		}
	}
}
