{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "Colibri Social",
	"version": "0.1.9",
	"identifier": "social.colibri.app",
	"build": {
		"beforeDevCommand": "pnpm dev",
		"devUrl": "http://127.0.0.1:1420",
		"beforeBuildCommand": "pnpm build",
		"frontendDist": "../dist"
	},
	"app": {
		"windows": [
			{
				"title": "Colibri",
				"width": 1200,
				"height": 800,
				"minWidth": 768,
				"minHeight": 768,
				"titleBarStyle": "Overlay",
				"hiddenTitle": true
			}
		],
		"security": {
			"csp": null
		}
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"createUpdaterArtifacts": true,
		"resources": {
			"../../assets/files/twemoji/72x72": "twemoji/72x72"
		},
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico",
			"icons/Colibri.icon",
			"icons/Assets.car"
		],
		"macOS": {
			"entitlements": "Entitlements.plist"
		},
		"category": "SocialNetworking",
		"publisher": "Colibri",
		"homepage": "https://colibri.social",
		"copyright": "Copyright © 2026 Louis Escher, Reuben Tier",
		"shortDescription": "Next-generation social chat on the AT Protocol",
		"longDescription": "Colibri is a next-generation social chat app built on the AT Protocol."
	},
	"plugins": {
		"updater": {
			"endpoints": [
				"https://colibri.social/{{target}}/{{arch}}/{{current_version}}"
			],
			"pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQ3NkY0NTJDMDNDREY5RkYKUldULytjMERMRVZ2MXhOWGlSTHZJbGFFV1lUbFZBQUJSSmN2VTE1clhmWnEyNjRFd0hFK3AvWkoK"
		},
		"deep-link": {
			"mobile": [
				{
					"scheme": [
						"social.colibri"
					]
				}
			],
			"desktop": {
				"schemes": [
					"social.colibri"
				]
			}
		}
	}
}
