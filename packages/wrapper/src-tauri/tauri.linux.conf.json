{
	"$schema": "https://schema.tauri.app/config/2",
	"build": {
		"beforeBundleCommand": "strip --strip-unneeded src-tauri/target/release/libcef.so"
	},
	"bundle": {
		"linux": {
			"deb": {
				"depends": [
					"libnss3",
					"libnspr4",
					"libatk-bridge2.0-0 | libatk-bridge2.0-0t64",
					"libcups2 | libcups2t64",
					"libdrm2",
					"libgbm1",
					"libxkbcommon0",
					"libxcomposite1",
					"libxdamage1",
					"libxrandr2",
					"libasound2 | libasound2t64"
				],
				"files": {
					"/usr/lib/colibri-social/libcef.so": "target/release/libcef.so",
					"/usr/lib/colibri-social/libEGL.so": "target/release/libEGL.so",
					"/usr/lib/colibri-social/libGLESv2.so": "target/release/libGLESv2.so",
					"/usr/lib/colibri-social/libvk_swiftshader.so": "target/release/libvk_swiftshader.so",
